# ==========================================
# Gyankosh .gitignore
# ==========================================

# Build & Static Output
dist/
dist-*/
build/
out/
.output/

# Astro Generated Types & Cache
.astro/
.cache/

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs & Diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# Temporary files & Testing
coverage/
.nyc_output/
*.tmp
*.temp
.turbo/
.vercel/
.netlify/

# Local SQLite Databases & CMS Working Cache
database/*.db
database/*.sqlite
database/*.sqlite3
database/gyankosh.db
