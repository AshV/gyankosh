{
  "name": "gyankosh",
  "type": "module",
  "version": "0.0.1",
  "homepage": "https://gyankosh.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/AshV/gyankosh.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og-cards.mjs && astro build",
    "og:generate": "node scripts/generate-og-cards.mjs",
    "og:generate:force": "node scripts/generate-og-cards.mjs --force",
    "preview": "astro preview",
    "serve": "http-server dist -p 4321 -c-1 --cors -o",
    "preview:serve": "node scripts/preview-server.mjs",
    "weights": "node scripts/list-weights.mjs",
    "weights:sync": "node scripts/list-weights.mjs --sync",
    "fonts:download": "node scripts/download-fonts.mjs",
    "covers:optimize": "node scripts/optimize-covers.mjs",
    "db:ingest": "php scripts/pipeline/md-to-sqlite.php",
    "db:export": "php scripts/pipeline/sqlite-to-md.php",
    "db:check": "php scripts/pipeline/sqlite-to-md.php --check",
    "cms": "frankenphp php-server --listen 127.0.0.1:8080 --root tools/cms",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
