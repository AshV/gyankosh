---
/**
 * src/pages/category/[category].astro
 * Category collection page — lists all texts in a given category.
 * One page generated per category at build-time via getStaticPaths.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { CATEGORIES } from '../../content.config';

export async function getStaticPaths() {
  const allTexts = await getCollection('library');

  return CATEGORIES.map(category => {
    const filtered = allTexts
      .filter(t => t.data.category === category)
      .sort((a, b) => {
        if (a.data.chapter != null && b.data.chapter != null) {
          return a.data.chapter - b.data.chapter;
        }
        if (a.data.chapter != null) return -1;
        if (b.data.chapter != null) return 1;
        return a.data.title.localeCompare(b.data.title);
      });
    return {
      params: { category: category.toLowerCase() },
      props: { category, texts: filtered },
    };
  });
}

const { category, texts } = Astro.props;

function toHindiDigits(num: number): string {
  const digits = ['०', '१', '२', '३', '४', '५', '६', '७', '८', '९'];
  return num.toString().split('').map(d => digits[parseInt(d, 10)] || d).join('');
}

const categoryMeta: Record<string, { icon: string; nameHindi: string; description: string }> = {
  Veda:      { icon: '🔥', nameHindi: 'वेद', description: 'सनातन वैदिक ऋचाएं, संहिताएं एवं मन्त्र — ऋग्वेद, सामवेद, यजुर्वेद एवं अथर्ववेद।' },
  Upanishad: { icon: '🕉️', nameHindi: 'उपनिषद्', description: 'वेदान्त दर्शन के आधारभूत पावन उपनिषद् — आत्मज्ञान एवं ब्रह्मविद्या का अमृत।' },
  Gita:    { icon: '🎵', nameHindi: 'श्रीमद्भगवद्गीता', description: 'कुरुक्षेत्र के पावन रणक्षेत्र में भगवान श्रीकृष्ण का पावन दिव्य उपदेश।' },
  Chalisa: { icon: '🪔', nameHindi: 'चालीसा', description: 'चालीस पावन पदों वाले देवी-देवताओं के स्तोत्र एवं नित्य पाठ।' },
  Purana:  { icon: '📖', nameHindi: 'पुराण', description: 'अठारह महापुराण एवं उपपुराण — सनातन इतिहास, सृष्टि-वर्णन एवं भक्ति-गाथा।' },
  Stotra:  { icon: '🌸', nameHindi: 'स्तोत्र', description: 'ऋषि-मुनियों एवं सन्तों द्वारा रचित देवी-देवताओं की पावन स्तुतियां।' },
  Other:   { icon: '📜', nameHindi: 'अन्य धर्मग्रंथ', description: 'विशिष्ट धार्मिक, दार्शनिक एवं आध्यात्मिक धर्मग्रंथ।' },
};

const meta = categoryMeta[category] ?? { icon: '📜', nameHindi: category, description: `${category} श्रेणी के पावन धर्मग्रंथ।` };

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = `https://www.ashishvishwakarma.com/gyankosh/category/${category.toLowerCase()}`;
const categoryCover = texts[0]?.data?.coverImage
  ? (texts[0].data.coverImage.startsWith('http') ? texts[0].data.coverImage : `https://www.ashishvishwakarma.com/gyankosh${texts[0].data.coverImage.startsWith('/') ? '' : '/'}${texts[0].data.coverImage}`)
  : 'https://www.ashishvishwakarma.com/gyankosh/og-default.jpg';

const jsonLdCollection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': `${meta.nameHindi} — ज्ञानकोश`,
  'description': meta.description,
  'url': canonicalUrl,
  'inLanguage': 'hi',
};

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'ज्ञानकोश',
      'item': 'https://www.ashishvishwakarma.com/gyankosh/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': meta.nameHindi,
      'item': canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={`${meta.nameHindi} — ज्ञानकोश`}
  description={`${meta.nameHindi} श्रेणी के ${toHindiDigits(texts.length)} ग्रंथ — ${meta.description}`}
  canonical={canonicalUrl}
  image={categoryCover}
  keywords={[meta.nameHindi, 'सनातन धर्म', 'हिन्दू धर्मग्रंथ', category]}
  jsonLd={[jsonLdCollection, jsonLdBreadcrumb]}
>
  <!-- Category Header -->
  <div class="container">
    <div class="category-header" aria-labelledby="category-title">
      <nav aria-label="मार्गदर्शक">
        <ol style="display:flex;gap:0.5rem;list-style:none;font-family:var(--font-devanagari);font-size:0.9rem;color:var(--color-text-muted);margin-bottom:1rem;">
          <li><a href={`${base}/`} style="color:var(--color-accent);text-decoration:none;">मुख्य सूची</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" style="color:var(--color-ink);font-weight:700;">{meta.nameHindi}</li>
        </ol>
      </nav>

      <h1 id="category-title" style="font-family:var(--font-devanagari);">
        <span aria-hidden="true">{meta.icon}</span> {meta.nameHindi}
      </h1>
      <p style="font-family:var(--font-devanagari);color:var(--color-text-muted);margin-top:0.5rem;max-width:55ch;font-size:1.05rem;">
        {meta.description}
      </p>
      <p style="font-family:var(--font-devanagari);font-size:0.9rem;color:var(--color-text-faint);margin-top:0.75rem;font-weight:600;">
        {toHindiDigits(texts.length)} ग्रंथ उपलब्ध
      </p>
    </div>

    <!-- Texts Grid -->
    {texts.length > 0 ? (
      <div class="book-grid" role="list" aria-label={`${meta.nameHindi} ग्रंथ`}>
        {texts.map(text => (
          <div role="listitem">
            <BookCard
              slug={text.id}
              title={text.data.title}
              author={text.data.author}
              description={text.data.description}
              category={text.data.category}
              language={text.data.language}
              coverColor={text.data.coverColor}
              coverImage={text.data.coverImage}
            />
          </div>
        ))}
      </div>
    ) : (
      <p style="font-family:var(--font-devanagari);color:var(--color-text-muted);padding:2rem 0;font-size:1.05rem;">
        इस श्रेणी में अभी कोई ग्रंथ उपलब्ध नहीं है।
      </p>
    )}
  </div>
</BaseLayout>
