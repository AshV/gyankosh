---
/**
 * src/pages/index.astro
 * Home Page — Library Catalog
 * Gyankosh Sacred Indic Paper Book Theme
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCard from "../components/BookCard.astro";
import { CATEGORIES } from "../content.config";
import { sortTexts } from "../utils/sorting";
import { tagToSlug } from "../utils/tags";
import { deriveSearchKeywords } from "../utils/search";

const allTexts = sortTexts(await getCollection("library"));

const totalTexts = allTexts.length;

function toHindiDigits(num: number): string {
  const digits = ["०", "१", "२", "३", "४", "५", "६", "७", "८", "९"];
  return num
    .toString()
    .split("")
    .map((d) => digits[parseInt(d, 10)] || d)
    .join("");
}

const categoryMeta: Record<
  string,
  { icon: string; nameHindi: string; description: string }
> = {
  Veda: {
    icon: "🔥",
    nameHindi: "वेद",
    description: "सनातन वैदिक ऋचाएं एवं मन्त्र",
  },
  Upanishad: {
    icon: "🕉️",
    nameHindi: "उपनिषद्",
    description: "वेदान्त दर्शन के आधारभूत पावन उपनिषद्",
  },
  Gita: {
    icon: "🎵",
    nameHindi: "गीता",
    description: "भगवान श्रीकृष्ण का दिव्य उपदेश",
  },
  Chalisa: {
    icon: "🪔",
    nameHindi: "चालीसा",
    description: "चालीस पदों वाले पावन स्तोत्र",
  },
  Purana: {
    icon: "📖",
    nameHindi: "पुराण",
    description: "अठारह महापुराण एवं उपपुराण",
  },
  Stotra: {
    icon: "🌸",
    nameHindi: "स्तोत्र",
    description: "देवी-देवताओं की पावन स्तुतियां",
  },
  Aarti: {
    icon: "🪔",
    nameHindi: "आरती",
    description: "नित्य देव-आराधना एवं मंगल आरतियाँ",
  },
  Other: {
    icon: "📜",
    nameHindi: "अन्य",
    description: "विशिष्ट धार्मिक एवं दार्शनिक ग्रन्थ",
  },
};

const categoryCounts = CATEGORIES.reduce(
  (acc, cat) => {
    acc[cat] = allTexts.filter((t) => t.data.category === cat).length;
    return acc;
  },
  {} as Record<string, number>,
);


// Collect unique tags with counts
const tagCounts = new Map<string, { name: string; count: number }>();
for (const text of allTexts) {
  for (const tag of text.data.tags ?? []) {
    const slug = tagToSlug(tag);
    const existing = tagCounts.get(slug);
    if (existing) {
      existing.count++;
    } else {
      tagCounts.set(slug, { name: tag, count: 1 });
    }
  }
}
const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => a[1].name.localeCompare(b[1].name));

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalUrl = "https://www.ashishvishwakarma.com/gyankosh/";
const ogImageUrl = "https://www.ashishvishwakarma.com/gyankosh/og-default.jpg";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ज्ञानकोश — सनातन वैदिक एवं पौराणिक धर्मग्रंथ संग्रह",
  description:
    "सनातन वैदिक एवं पौराणिक धर्मग्रंथों का पावन डिजिटल पुस्तकालय — वेद, श्रीमद्भगवद्गीता, हनुमान चालीसा, पुराण।",
  url: "https://www.ashishvishwakarma.com/gyankosh",
  inLanguage: "hi",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: "https://www.ashishvishwakarma.com/gyankosh/?q={search_term_string}",
    },
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title="ज्ञानकोश — सनातन वैदिक एवं पौराणिक धर्मग्रंथ"
  description={`पढ़िए ${toHindiDigits(totalTexts)}+ सनातन धर्मग्रंथ ऑनलाइन — वेद, श्रीमद्भगवद्गीता, हनुमान चालीसा, पुराण। पारम्परिक पौथी शैली का डिजिटल पाठक।`}
  canonical={canonicalUrl}
  image={ogImageUrl}
  jsonLd={jsonLd}
>
  <!-- Sacred Hero Invocation Section -->
  <section class="catalog-hero" aria-labelledby="hero-heading">
    <div class="container">
      <div class="sacred-hero-invocation">॥ श्रीहरिः ॥</div>

      <h1 id="hero-heading">ज्ञानकोश</h1>
      <p class="hero-subtitle">वैदिक एवं पौराणिक धर्मग्रंथों का डिजिटल पुस्तकालय।</p>

      <!-- Category Bubbles for Smaller Screens (shown in place of subtitle) -->
      <nav class="hero-category-bubbles" aria-label="धर्मग्रंथ श्रेणियां">
        {
          CATEGORIES.map(
            (cat) =>
              categoryCounts[cat] > 0 && (
                <a
                  href={`${base}/category/${cat.toLowerCase()}`}
                  class="category-bubble"
                  title={`${categoryMeta[cat]?.nameHindi || cat} श्रेणी देखें`}
                >
                  <span class="bubble-icon" aria-hidden="true">
                    {categoryMeta[cat]?.icon}
                  </span>
                  <span class="bubble-label">
                    {categoryMeta[cat]?.nameHindi || cat}
                  </span>
                  <span class="bubble-count">
                    {toHindiDigits(categoryCounts[cat])}
                  </span>
                </a>
              ),
          )
        }
      </nav>
    </div>
  </section>

  <!-- Main Unified Library Shelf Container -->
  <div class="container">
    <!-- Saved Texts Shelf (Always on top when items are saved) -->
    <section id="saved-shelf" class="saved-shelf catalog-section" style="display: none; padding-top: 0; padding-bottom: 2rem;" aria-label="सहेजे गए ग्रंथ">
      <div class="saved-shelf-header">
        <h2 class="catalog-section-title">
          <span aria-hidden="true">🔖</span> सहेजे गए ग्रंथ
          <span id="saved-count-badge" class="saved-count-chip">०</span>
        </h2>
        <span class="saved-shelf-note">आपके द्वारा सहेजे गए पावन ग्रंथ — नित्य पठन एवं मनन हेतु</span>
      </div>
      <div class="book-grid" id="saved-book-grid" role="list" aria-label="सहेजे गए ग्रंथ सूची">
        <!-- Dynamically populated from client-side saved list -->
      </div>
    </section>

    <!-- All Texts Section Header (shown when saved shelf is active) -->
    <div id="all-texts-header" class="all-texts-header" style="display: none;">
      <h2 class="catalog-section-title">
        <span aria-hidden="true">📚</span> सम्पूर्ण धर्मग्रंथ
      </h2>
    </div>

    <!-- Catalog Search & Category Filter Controls -->
    <section
      class="search-filter-section"
      aria-label="ग्रंथ खोज एवं श्रेणी छाननी"
    >
      <div class="search-box-wrapper">
        <span class="search-box-icon" aria-hidden="true">🔍</span>
        <input
          type="search"
          id="catalog-search-input"
          class="catalog-search-input"
          placeholder="ग्रंथ, देवता या विषय खोजें... (उदा. हनुमान, Gita, शिव)"
          autocomplete="off"
          spellcheck="false"
          aria-label="ग्रंथ खोजें"
        />
        <button
          type="button"
          id="catalog-search-clear"
          class="search-clear-btn"
          aria-label="खोज साफ़ करें"
          style="display: none;"
        >
          ✕
        </button>
      </div>

      <div class="filter-container">
        <span class="filter-label">श्रेणी:</span>
        <button
          class="filter-pill active"
          data-category="all"
          aria-pressed="true"
        >
          <span>सभी</span>
          <span class="pill-count">{toHindiDigits(totalTexts)}</span>
        </button>
        {
          CATEGORIES.map(
            (cat) =>
              categoryCounts[cat] > 0 && (
                <button
                  class="filter-pill"
                  data-category={cat}
                  aria-pressed="false"
                >
                  <span>
                    {categoryMeta[cat]?.icon}{" "}
                    {categoryMeta[cat]?.nameHindi || cat}
                  </span>
                  <span class="pill-count">
                    {toHindiDigits(categoryCounts[cat])}
                  </span>
                </button>
              ),
          )
        }
      </div>
    </section>

    <!-- Library Shelf Header -->
    <div class="results-bar" id="catalog-results-bar">
      <div class="results-count-wrapper">
        <span>उपलब्ध ग्रंथ: </span>
        <span id="results-count" class="results-count"
          >{toHindiDigits(totalTexts)}</span
        >
      </div>
      <div id="results-subtext" style="font-size: 0.85rem; color: var(--color-text-faint);">
        सम्पूर्ण संग्रह
      </div>
    </div>

    <!-- Unified Grid Layout -->
    <div
      class="book-grid"
      id="book-grid"
      role="list"
      aria-label="सनातन धर्मग्रंथ सूची"
    >
      {
        allTexts.map((text) => {
          const keywords = deriveSearchKeywords(text).join(' ');
          const tagsStr = (text.data.tags || []).join(' ');
          return (
            <div
              role="listitem"
              class="book-card-wrapper"
              data-slug={text.id.replace(/\.md$/, '')}
              data-title={text.data.title}
              data-author={text.data.author || ""}
              data-description={text.data.description}
              data-category={text.data.category}
              data-tags={tagsStr}
              data-keywords={keywords}
            >
              <BookCard
                slug={text.id}
                title={text.data.title}
                author={text.data.author}
                description={text.data.description}
                category={text.data.category}
                language={text.data.language}
                coverColor={text.data.coverColor}
                coverImage={text.data.coverImage}
              />
            </div>
          );
        })
      }
    </div>

    <!-- Empty State -->
    <div id="catalog-empty-state" class="catalog-empty-state" style="display: none;">
      <div class="empty-icon" aria-hidden="true">🪷</div>
      <h3 class="empty-title">कोई ग्रंथ नहीं मिला</h3>
      <p id="catalog-empty-desc" class="empty-desc">
        कृपया अन्य शब्द, देवता का नाम या English में खोज कर देखें।
      </p>
      <button type="button" id="catalog-reset-btn" class="catalog-reset-btn">
        सभी ग्रंथ देखें
      </button>
    </div>

    <!-- Tag Cloud Section (विषय टैग) -->
    {sortedTags.length > 0 && (
      <section class="tag-section" aria-label="विषय टैग">
        <h2 class="tag-section-title">
          <span aria-hidden="true">🪷</span> विषय (Tags)
        </h2>
        <div class="tag-cloud">
          {sortedTags.map(([slug, { name, count }]) => (
            <a href={`${base}/tag/${slug}`} class="tag-chip">
              <span>{name}</span>
              <span class="tag-count">{toHindiDigits(count)}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  function toHindiDigits(num: number): string {
    const digits = ["०", "१", "२", "३", "४", "५", "६", "७", "८", "९"];
    return num
      .toString()
      .split("")
      .map((d) => digits[parseInt(d, 10)] || d)
      .join("");
  }

  // Refresh saved texts shelf on top
  function refreshGyankoshSavedShelf() {
    const savedShelf = document.getElementById("saved-shelf");
    const savedGrid = document.getElementById("saved-book-grid");
    const savedCountBadge = document.getElementById("saved-count-badge");
    const allTextsHeader = document.getElementById("all-texts-header");
    if (!savedShelf || !savedGrid) return;

    let saved: string[] = [];
    try {
      saved = JSON.parse(localStorage.getItem("gyankosh_saved") || "[]");
    } catch {
      saved = [];
    }

    if (!saved.length) {
      savedShelf.style.display = "none";
      if (allTextsHeader) allTextsHeader.style.display = "none";
      return;
    }

    savedGrid.innerHTML = "";
    let count = 0;

    saved.forEach((slug) => {
      const orig = document.querySelector<HTMLElement>(
        `#book-grid .book-card-wrapper[data-slug="${slug}"]`
      );
      if (orig) {
        const clone = orig.cloneNode(true) as HTMLElement;
        clone.classList.add("visible");
        savedGrid.appendChild(clone);
        count++;
      }
    });

    if (count > 0) {
      if (savedCountBadge) savedCountBadge.textContent = toHindiDigits(count);
      savedShelf.style.display = "block";
      if (allTextsHeader) allTextsHeader.style.display = "block";
    } else {
      savedShelf.style.display = "none";
      if (allTextsHeader) allTextsHeader.style.display = "none";
    }

    // Refresh states on newly cloned buttons
    if (typeof (window as any).updateSaveButtonStates === "function") {
      (window as any).updateSaveButtonStates();
    }
  }

  (window as any).refreshGyankoshSavedShelf = refreshGyankoshSavedShelf;

  window.addEventListener("gyankosh:saved-changed", () => {
    refreshGyankoshSavedShelf();
  });

  import { normalizeSearchText } from "../utils/search";

  document.addEventListener("DOMContentLoaded", () => {
    refreshGyankoshSavedShelf();

    const searchInput = document.getElementById("catalog-search-input") as HTMLInputElement | null;
    const searchClearBtn = document.getElementById("catalog-search-clear");
    const filterPills = document.querySelectorAll(".filter-pill");
    const bookWrappers = document.querySelectorAll(
      ".book-card-wrapper",
    ) as NodeListOf<HTMLElement>;
    const resultsCount = document.getElementById("results-count");
    const resultsSubtext = document.getElementById("results-subtext");
    const emptyState = document.getElementById("catalog-empty-state");
    const emptyDesc = document.getElementById("catalog-empty-desc");
    const resetBtn = document.getElementById("catalog-reset-btn");
    const bookGrid = document.getElementById("book-grid");

    if (!bookWrappers.length || !resultsCount) return;

    let activeCategory = "all";

    // Scroll reveal animation using IntersectionObserver
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        rootMargin: "0px 0px -50px 0px",
        threshold: 0.1,
      },
    );

    bookWrappers.forEach((wrapper) => {
      revealObserver.observe(wrapper);
    });

    function filterLibrary() {
      const rawQuery = (searchInput?.value || "").trim();
      const normQuery = normalizeSearchText(rawQuery);
      const queryTokens = normQuery.split(" ").filter(Boolean);

      if (searchClearBtn) {
        searchClearBtn.style.display = rawQuery ? "block" : "none";
      }

      let visibleCount = 0;

      bookWrappers.forEach((wrapper) => {
        const category = wrapper.dataset.category || "";
        const matchesCategory =
          activeCategory === "all" || category === activeCategory;

        if (!matchesCategory) {
          wrapper.classList.add("hidden");
          return;
        }

        if (!rawQuery) {
          wrapper.classList.remove("hidden");
          visibleCount++;
          return;
        }

        const title = normalizeSearchText(wrapper.dataset.title || "");
        const slug = normalizeSearchText((wrapper.dataset.slug || "").replace(/-/g, " "));
        const author = normalizeSearchText(wrapper.dataset.author || "");
        const cat = normalizeSearchText(wrapper.dataset.category || "");
        const tags = normalizeSearchText(wrapper.dataset.tags || "");
        const keywords = normalizeSearchText(wrapper.dataset.keywords || "");

        const combined = `${title} ${slug} ${author} ${cat} ${tags} ${keywords}`;

        const matchesText = queryTokens.every((token) => combined.includes(token));

        if (matchesText) {
          wrapper.classList.remove("hidden");
          visibleCount++;
        } else {
          wrapper.classList.add("hidden");
        }
      });

      // Update count text
      resultsCount.textContent = toHindiDigits(visibleCount);

      // Handle Empty State
      if (visibleCount === 0) {
        if (emptyState) emptyState.style.display = "block";
        if (bookGrid) bookGrid.style.display = "none";
        if (emptyDesc) {
          emptyDesc.textContent = `‘${rawQuery}’ के लिए कोई ग्रंथ नहीं मिला। कृपया अन्य शब्द, देवता का नाम या English में खोज कर देखें।`;
        }
        if (resultsSubtext) resultsSubtext.textContent = "कोई परिणाम नहीं";
      } else {
        if (emptyState) emptyState.style.display = "none";
        if (bookGrid) bookGrid.style.display = "grid";
        if (resultsSubtext) {
          resultsSubtext.textContent = rawQuery ? "खोज परिणाम" : "सम्पूर्ण संग्रह";
        }
      }
    }

    // Live search input handler with URL sync
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        filterLibrary();
        const val = searchInput.value.trim();
        const url = new URL(window.location.href);
        if (val) {
          url.searchParams.set("q", val);
        } else {
          url.searchParams.delete("q");
        }
        window.history.replaceState({}, "", url.toString());
      });
    }

    // Clear Button Handler
    if (searchClearBtn) {
      searchClearBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchInput.focus();
          filterLibrary();
          const url = new URL(window.location.href);
          url.searchParams.delete("q");
          window.history.replaceState({}, "", url.toString());
        }
      });
    }

    // Reset Button Handler
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        activeCategory = "all";
        filterPills.forEach((p) => {
          const isAll = p.getAttribute("data-category") === "all";
          p.classList.toggle("active", isAll);
          p.setAttribute("aria-pressed", isAll ? "true" : "false");
        });
        filterLibrary();
        const url = new URL(window.location.href);
        url.searchParams.delete("q");
        window.history.replaceState({}, "", url.toString());
      });
    }

    // Check URL query on initial load (?q=...)
    const initialQ = new URLSearchParams(window.location.search).get("q");
    if (initialQ && searchInput) {
      searchInput.value = initialQ;
      filterLibrary();
    }

    // Category Pill Events
    filterPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        filterPills.forEach((p) => {
          p.classList.remove("active");
          p.setAttribute("aria-pressed", "false");
        });
        pill.classList.add("active");
        pill.setAttribute("aria-pressed", "true");
        activeCategory = pill.getAttribute("data-category") || "all";
        filterLibrary();
      });
    });
  });
</script>
