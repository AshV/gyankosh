---
/**
 * src/pages/read/[slug].astro
 * The Reader View — one page per text, generated at build-time.
 * Uses the custom indicParser to convert raw MD body → semantic HTML.
 * All interactive features (transliteration, themes, etc.) via client scripts in ReaderLayout.
 */
import { getCollection } from 'astro:content';
import { parseIndicMarkdown } from '../../utils/indicParser';
import ReaderLayout from '../../layouts/ReaderLayout.astro';

const categoryMeta: Record<string, { nameHindi: string }> = {
  Veda:      { nameHindi: 'वेद' },
  Upanishad: { nameHindi: 'उपनिषद्' },
  Gita:      { nameHindi: 'गीता' },
  Chalisa:   { nameHindi: 'चालीसा' },
  Purana:    { nameHindi: 'पुराण' },
  Stotra:    { nameHindi: 'स्तोत्र' },
  Aarti:     { nameHindi: 'आरती' },
  Other:     { nameHindi: 'अन्य' },
};

export async function getStaticPaths() {
  const allTexts = await getCollection('library');
  return allTexts.map(entry => ({
    params: { slug: entry.id },
    props: {
      entry,
      // Pass related texts from the same category (excluding self), max 4
      relatedTexts: allTexts
        .filter(t => t.data.category === entry.data.category && t.id !== entry.id)
        .slice(0, 4),
    },
  }));
}

const { entry, relatedTexts } = Astro.props;
const { data } = entry;

// ── Build-time parsing ──────────────────────────────────────
// entry.body is the raw Markdown string (no frontmatter).
// We pass it through our custom parser to get semantic HTML.
// Zero client-side parsing cost — all done at build time.
const parsedHtml = parseIndicMarkdown(entry.body, { showNumbering: data.showNumbering });

// ── Resolve URLs ─────────────────────────────────────────────
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = `https://www.ashishvishwakarma.com/gyankosh/read/${entry.id}`;
const coverImageUrl = data.coverImage
  ? `https://www.ashishvishwakarma.com/gyankosh${data.coverImage.startsWith('/') ? '' : '/'}${data.coverImage}`
  : `https://www.ashishvishwakarma.com/gyankosh/covers/${entry.id}.jpg`;
const catKey = data.category;
const catNameHindi = categoryMeta[catKey]?.nameHindi ?? catKey;

// ── JSON-LD Schema (Book) — enriched ─────────────────────────
const jsonLdBook: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  'name': data.title,
  'description': data.description,
  'inLanguage': data.language,
  'genre': data.category,
  'url': canonicalUrl,
  'image': coverImageUrl,
  'isAccessibleForFree': true,
  'license': 'https://creativecommons.org/licenses/by-sa/4.0/',
  'publisher': {
    '@type': 'Organization',
    'name': 'ज्ञानकोश',
    'url': 'https://www.ashishvishwakarma.com/gyankosh',
  },
};

if (data.author) {
  jsonLdBook['author'] = {
    '@type': 'Person',
    'name': data.author,
  };
}

if (data.chapter !== undefined) {
  jsonLdBook['position'] = data.chapter;
}

// ── JSON-LD Breadcrumb ───────────────────────────────────────
const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'ज्ञानकोश',
      'item': 'https://www.ashishvishwakarma.com/gyankosh/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': catNameHindi,
      'item': `https://www.ashishvishwakarma.com/gyankosh/category/${catKey.toLowerCase()}`,
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': data.title,
      'item': canonicalUrl,
    },
  ],
};

// ── Keywords from tags ───────────────────────────────────────
const keywords = [
  data.title,
  catNameHindi,
  data.category,
  ...(data.tags ?? []),
  'सनातन धर्म',
  'हिन्दू धर्मग्रंथ',
];
if (data.author) keywords.push(data.author);
---

<ReaderLayout
  title={data.title}
  description={data.description}
  canonical={canonicalUrl}
  author={data.author}
  language={data.language}
  category={data.category}
  coverColor={data.coverColor}
  coverImage={data.coverImage}
  slug={entry.id}
  image={coverImageUrl}
  keywords={keywords}
  jsonLd={[jsonLdBook, jsonLdBreadcrumb]}
  showNumbering={data.showNumbering}
  tags={data.tags}
>
  <!--
    The parsed HTML is injected here via set:html.
    All verse blocks, padas, translation blocks etc. are pre-rendered at build time.
    NO JavaScript parsing happens in the browser for this content.
  -->
  <Fragment set:html={parsedHtml} />

  <!-- Related Texts — Internal Linking for SEO -->
  {relatedTexts.length > 0 && (
    <nav class="related-texts" aria-label="इस श्रेणी के अन्य ग्रंथ">
      <h2 class="related-heading">इस श्रेणी के अन्य ग्रंथ</h2>
      <ul class="related-list">
        {relatedTexts.map((rt: any) => (
          <li>
            <a href={`${base}/read/${rt.id}`} class="related-link">
              <span class="related-title">{rt.data.title}</span>
              {rt.data.author && <span class="related-author">{rt.data.author}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</ReaderLayout>

<style>
  /* Related Texts Section — matches sacred paper aesthetic */
  .related-texts {
    margin-top: 3rem;
    padding: 2rem 1.5rem;
    border-top: 2px solid var(--color-border);
    background: var(--color-bg-elevated);
    border-radius: 8px;
    font-family: var(--font-devanagari);
  }

  .related-heading {
    font-family: var(--font-devanagari);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 1rem;
    text-align: center;
  }

  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .related-link {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .related-link:hover {
    border-color: var(--color-accent);
    box-shadow: 0 2px 8px rgba(142, 27, 20, 0.1);
  }

  .related-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .related-author {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }
</style>
