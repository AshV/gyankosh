---
/**
 * src/pages/read/[slug].astro
 * The Reader View — one page per text, generated at build-time.
 * Uses the custom indicParser to convert raw MD body → semantic HTML.
 * All interactive features (transliteration, themes, etc.) via client scripts in ReaderLayout.
 */
import { getCollection } from 'astro:content';
import { parseIndicMarkdown, computeBuildReadingStats } from '../../utils/indicParser';
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import { sortTexts } from '../../utils/sorting';
import { getCategoryHindi } from '../../data/categoryMeta';

export async function getStaticPaths() {
  const allTexts = sortTexts(await getCollection('library'));
  return allTexts.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevText: index > 0 ? { slug: allTexts[index - 1].id, title: allTexts[index - 1].data.title } : null,
      nextText: index < allTexts.length - 1 ? { slug: allTexts[index + 1].id, title: allTexts[index + 1].data.title } : null,
    },
  }));
}

const { entry, prevText, nextText } = Astro.props;
const { data } = entry;

// ── Build-time parsing & statistics ──────────────────────────
// entry.body is the raw Markdown string (no frontmatter).
// We pass it through our custom parser to get semantic HTML.
// Zero client-side parsing cost — all done at build time.
const parsedHtml = parseIndicMarkdown(entry.body, { showNumbering: data.showNumbering });
const readingStats = computeBuildReadingStats(entry.body);

// ── Resolve URLs ─────────────────────────────────────────────
const siteUrl = 'https://www.ashishvishwakarma.com/gyankosh';
const canonicalUrl = `${siteUrl}/read/${entry.id}`;
const ogImageUrl = `${siteUrl}/og/${entry.id}.jpg`;
const catKey = data.category;
const catNameHindi = getCategoryHindi(catKey);

// ── SEO Title & High-Intent Meta Description ────────────────
const seoTitle = `${data.title} — शुद्ध पाठ एवं प्रामाणिक हिन्दी अर्थ`;
const seoDescription = data.context
  ? `${data.description} ${data.context} सम्पूर्ण पाठ एवं प्रामाणिक हिन्दी अर्थ सहित।`
  : `${data.description} सम्पूर्ण पाठ, शुद्ध उच्चारण एवं प्रामाणिक हिन्दी भावार्थ सहित।`;

const languages = data.language?.toLowerCase().includes('sanskrit')
  ? ['sa', 'hi']
  : [data.language || 'hi'];

// ── Keywords from tags & high-intent terms (deduplicated) ───
const keywords = [...new Set([
  data.title,
  `${data.title} पाठ`,
  `${data.title} अर्थ सहित`,
  `${data.title} भावार्थ`,
  catNameHindi,
  data.category,
  ...(data.tags ?? []),
  'सनातन धर्म',
  'हिन्दू धर्मग्रंथ',
  'संस्कृत श्लोक',
  'शुद्ध उच्चारण',
  ...(data.author ? [data.author] : []),
])];

// ── JSON-LD Schema (Book) — enriched ─────────────────────────
const jsonLdBook: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  'name': data.title,
  'headline': seoTitle,
  'description': data.description,
  'inLanguage': languages,
  'genre': data.category,
  'keywords': keywords.join(', '),
  'url': canonicalUrl,
  'image': ogImageUrl,
  'isAccessibleForFree': true,
  'license': 'https://creativecommons.org/licenses/by-sa/4.0/',
  'isPartOf': {
    '@type': 'WebSite',
    'name': 'ज्ञानकोश',
    'url': siteUrl,
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'ज्ञानकोश',
    'url': siteUrl,
  },
};

if (data.context) {
  jsonLdBook['abstract'] = data.context;
}

if (data.author) {
  jsonLdBook['author'] = {
    '@type': 'Person',
    'name': data.author,
  };
}

if (data.chapter !== undefined) {
  jsonLdBook['position'] = data.chapter;
}

// ── JSON-LD Breadcrumb ───────────────────────────────────────
const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'ज्ञानकोश',
      'item': `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': catNameHindi,
      'item': `${siteUrl}/category/${catKey.toLowerCase()}`,
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': data.title,
      'item': canonicalUrl,
    },
  ],
};
---

<ReaderLayout
  title={data.title}
  seoTitle={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  author={data.author}
  language={data.language}
  category={data.category}
  coverColor={data.coverColor}
  coverImage={data.coverImage}
  slug={entry.id}
  image={ogImageUrl}
  keywords={keywords}
  jsonLd={[jsonLdBook, jsonLdBreadcrumb]}
  showNumbering={data.showNumbering}
  tags={data.tags}
  context={data.context}
  prevText={prevText}
  nextText={nextText}
  readingStats={readingStats}
>
  <!--
    The parsed HTML is injected here via set:html.
    All verse blocks, padas, translation blocks etc. are pre-rendered at build time.
    NO JavaScript parsing happens in the browser for this content.
  -->
  <Fragment set:html={parsedHtml} />

</ReaderLayout>

