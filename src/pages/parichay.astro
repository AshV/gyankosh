---
/**
 * src/pages/parichay.astro
 * Gyankosh Mission, Provenance & Editorial Authenticity (E-E-A-T)
 * 100% Hindi / Devanagari interface matching the warm paper aesthetic.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = 'https://www.ashishvishwakarma.com/gyankosh/parichay';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': 'ज्ञानकोश परिचय — सनातन धर्मग्रंथों का पावन डिजिटल पुस्तकालय',
  'description': 'ज्ञानकोश की कहानी, सनातन ग्रंथों का विशुद्ध पाठ और एकाग्र पठन का हमारा विनम्र संकल्प।',
  'url': canonicalUrl,
  'inLanguage': 'hi',
  'mainEntity': {
    '@type': 'Organization',
    'name': 'ज्ञानकोश',
    'url': 'https://www.ashishvishwakarma.com/gyankosh',
    'description': 'सनातन वैदिक एवं पौराणिक धर्मग्रंथों का पावन, विशुद्ध एवं विज्ञापन-मुक्त डिजिटल संग्रह।',
    'founder': {
      '@type': 'Person',
      'name': 'आशीष विश्वकर्मा (Ashish Vishwakarma)',
      'url': 'https://www.ashishvishwakarma.com',
    },
  },
};
---

<BaseLayout
  title="परिचय — ज्ञानकोश"
  description="ज्ञानकोश की कहानी, सनातन धर्मग्रंथों का विशुद्ध पाठ और एकाग्र पठन का हमारा विनम्र संकल्प।"
  canonical={canonicalUrl}
  jsonLd={jsonLd}
>
  <article class="parichay-page" aria-labelledby="parichay-heading">
    <div class="container parichay-container">
      
      <!-- Sacred Header -->
      <header class="parichay-header">
        <div class="parichay-invocation">॥ श्रीहरिः ॥</div>
        <h1 id="parichay-heading" class="parichay-title">ज्ञानकोश — एक विनम्र परिचय</h1>
        <p class="parichay-subtitle">डिजिटल युग में पारम्परिक पोथी की शुचिता, शांति और एकाग्रता</p>
      </header>

      <!-- Section 1: Mission & Story -->
      <section class="parichay-card" aria-labelledby="sec-mission">
        <div class="card-icon" aria-hidden="true">🪔</div>
        <h2 id="sec-mission" class="card-title">॥ यह प्रयास क्यों? — एक छोटी-सी टीस से शुरुआत ॥</h2>
        <p class="card-text">
          हम सबने कभी न कभी यह अनुभव किया है—जब भी मन में किसी स्तोत्र, चालीसा या मन्त्र का पाठ करने की इच्छा हुई और हमने फोन निकाला, तो सामने आए ढेरों विज्ञापन, भटकाने वाले पॉप-अप्स और अव्यवस्थित लिखावट। पूजा, पाठ या ध्यान के उस शांत क्षण में स्क्रीन की यह आपाधापी मन की एकाग्रता को तोड़ देती थी।
        </p>
        <p class="card-text">
          इसी अनुभव ने मन में एक संकल्प जगाया—<strong>क्या हमारे धर्मग्रंथों को डिजिटल माध्यम में भी वही आदर और पवित्रता नहीं मिलनी चाहिए, जो घर के मंदिर में रखी किसी पुरानी पोथी को मिलती है?</strong> इसी सोच से 'ज्ञानकोश' का जन्म हुआ—एक ऐसा शांत कोना जहाँ कोई विज्ञापन नहीं, कोई जल्दबाजी नहीं; बस आप और हमारे ऋषियों की पावन वाणी।
        </p>
      </section>

      <!-- Section 2: Heritage & Tradition -->
      <section class="parichay-card" aria-labelledby="sec-authenticity">
        <div class="card-icon" aria-hidden="true">📜</div>
        <h2 id="sec-authenticity" class="card-title">॥ हमारी साझी धरोहर — ऋषियों की अनमोल देन ॥</h2>
        <p class="card-text">
          ज्ञानकोश में संकलित वेद, उपनिषद्, गीता, स्तोत्र और पुराण किसी एक व्यक्ति या संस्था की सम्पत्ति नहीं हैं। ये उस अनादि आर्ष परम्परा की देन हैं, जिसे हमारे ऋषि-मुनियों और संत-महात्माओं ने सहस्रों वर्षों से तपस्या और गुरु-शिष्य परम्परा के माध्यम से सहेज कर हम तक पहुँचाया है।
        </p>
        <p class="card-text">
          हमारा काम केवल एक विनम्र माध्यम बनना है—उस पावन ज्ञान को आज के डिजिटल स्वरूप में इस तरह प्रस्तुत करना कि वह हर साधक और जिज्ञासु के लिए पूरी शुचिता के साथ सुलभ हो सके। यहाँ संकलित समस्त मूल पाठ वही हैं जो सदियों से हमारे परिवारों और मन्दिरों में नित्य श्रद्धापूर्वक गाए और पढ़े जाते रहे हैं।
        </p>
      </section>

      <!-- Section 3: Devotion to Accuracy & Ease -->
      <section class="parichay-card" aria-labelledby="sec-editorial">
        <div class="card-icon" aria-hidden="true">✍️</div>
        <h2 id="sec-editorial" class="card-title">॥ पाठ की शुद्धता एवं सहज पठन का यत्न ॥</h2>
        <p class="card-text">
          संस्कृत और अवधी जैसी पावन भाषाओं में एक छोटी-सी मात्रा, हलन्त या विसर्ग के अंतर से भी उच्चारण और भाव बदल जाता है। इसलिए हमने तकनीक का उपयोग ग्रंथों को बदलने के लिए नहीं, बल्कि उन्हें उनके मूल रूप में सहजता से पढ़ने योग्य बनाने के लिए किया है:
        </p>
        <ul class="parichay-list">
          <li><strong>लयबद्ध पद-संरेखण:</strong> श्लोकों के चरणों को इस तरह संजोया गया है ताकि नित्य पाठ करते समय आपकी लय और श्वास का स्वाभाविक प्रवाह बना रहे।</li>
          <li><strong>शुद्ध उच्चारण और वर्तनी:</strong> पारम्परिक देवनागरी संयुक्ताक्षरों की स्पष्टता पर विशेष ध्यान दिया गया है, ताकि उच्चारण में कोई संशय न रहे।</li>
          <li><strong>साधकों के लिए 'पाठ मोड':</strong> जब आप नित्य पाठ या जप कर रहे हों, तो केवल एक स्पर्श से भावार्थ छिपाकर एकाग्रता के साथ केवल मूल श्लोकों का वाचन कर सकते हैं।</li>
          <li><strong>नेत्रों पर सहज अनुभव:</strong> हल्की गर्म कागजी आभा (Warm Paper), सुंदर लाल किनारी और मनपसंद अक्षर-आकार, ताकि लंबे समय तक पढ़ते हुए भी आँखों में थकान न हो।</li>
        </ul>
      </section>

      <!-- Section 4: Selfless Service -->
      <section class="parichay-card" aria-labelledby="sec-stewardship">
        <div class="card-icon" aria-hidden="true">🕉️</div>
        <h2 id="sec-stewardship" class="card-title">॥ एक निःस्वार्थ भाव — सेवा ही ध्येय ॥</h2>
        <p class="card-text">
          ज्ञानकोश का निर्माण <strong><a href="https://www.ashishvishwakarma.com" target="_blank" rel="noopener" class="author-link">आशीष विश्वकर्मा (Ashish Vishwakarma)</a></strong> द्वारा अपनी संस्कृति, भाषा और पूर्वजों के प्रति कृतज्ञता व्यक्त करने के विनम्र प्रयास के रूप में किया गया है।
        </p>
        <p class="card-text">
          यह कोई व्यावसायिक उद्यम या मुनाफे का साधन नहीं है। हमारा एकमात्र ध्येय यह है कि हमारी आने वाली पीढ़ियाँ और दुनिया भर में फैले सनातन प्रेमी जब भी अपनी जड़ों से जुड़ना चाहें, तो उन्हें एक पवित्र, विज्ञापन-मुक्त और प्रामाणिक आश्रय मिल सके।
        </p>
      </section>

      <!-- Section 5: Corrections & Community -->
      <section class="parichay-card" aria-labelledby="sec-feedback">
        <div class="card-icon" aria-hidden="true">🙏</div>
        <h2 id="sec-feedback" class="card-title">॥ हम भी सीख रहे हैं — आपका सहयोग सादर प्रार्थनीय ॥</h2>
        <p class="card-text">
          हम इंसान हैं और इतने विशाल साहित्य को डिजिटल रूप में संजोने के इस पुनीत प्रयास में अनजाने में कोई मात्रा, वर्तनी या पाठ-भेद की त्रुटि रह जाना सर्वथा संभव है।
        </p>
        <p class="card-text">
          यदि पढ़ते समय आपको कहीं भी कोई भूल दिखाई दे, तो कृपया इसे पराया न समझें। एक सहृदय मार्गदर्शक की भाँति हमें अवश्य बताएं ताकि हम तुरंत सुधार कर सकें। आपकी छोटी-सी सलाह भी इस ग्रंथ-संग्रह को और अधिक निर्मल बनाने में अनमोल साबित होगी।
        </p>
        <div class="feedback-action-box">
          <a href="https://github.com/AshV/gyankosh/issues" target="_blank" rel="noopener" class="btn-feedback">
            <span>📝</span> सुझाव या त्रुटि बताएं (GitHub)
          </a>
          <a href={`${base}/`} class="btn-back-home">
            <span>📖</span> पुस्तकालय मुख्य पृष्ठ
          </a>
        </div>
      </section>

    </div>
  </article>
</BaseLayout>

<style>
  .parichay-page {
    padding: 2rem 1rem 4rem;
    font-family: var(--font-devanagari);
  }

  .parichay-container {
    max-width: 780px;
    margin: 0 auto;
  }

  .parichay-header {
    text-align: center;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .parichay-invocation {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .parichay-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .parichay-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .parichay-card {
    background: var(--color-bg-card);
    background-image: 
      radial-gradient(ellipse at 50% 10%, rgba(255, 252, 245, 0.98), rgba(248, 241, 226, 0.98)),
      linear-gradient(to bottom, rgba(0,0,0,0.02) 0%, transparent 10%);
    border: 2px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem 1.75rem;
    margin-bottom: 2rem;
    box-shadow: 
      0 4px 15px rgba(60, 35, 15, 0.08),
      0 1px 3px rgba(60, 35, 15, 0.05);
    position: relative;
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0 0 1rem;
  }

  .card-text {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }

  .card-text:last-child {
    margin-bottom: 0;
  }

  .parichay-list {
    margin: 0 0 1rem 1.25rem;
    padding: 0;
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--color-ink);
  }

  .parichay-list li {
    margin-bottom: 0.6rem;
  }

  .author-link {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .author-link:hover {
    color: var(--color-gold);
  }

  .feedback-action-box {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-feedback, .btn-back-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-devanagari);
    font-size: 1rem;
    font-weight: 700;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-feedback {
    background: var(--color-accent);
    color: #ffffff;
  }

  .btn-feedback:hover {
    background: color-mix(in hsl, var(--color-accent), black 15%);
    transform: translateY(-1px);
  }

  .btn-back-home {
    background: transparent;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
  }

  .btn-back-home:hover {
    background: rgba(142, 27, 20, 0.08);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .parichay-title {
      font-size: 1.6rem;
    }
    .parichay-card {
      padding: 1.25rem 1.1rem;
    }
    .card-title {
      font-size: 1.15rem;
    }
    .card-text, .parichay-list {
      font-size: 0.98rem;
    }
  }
</style>
