---
/**
 * src/pages/parichay.astro
 * Gyankosh Mission, Provenance & Editorial Authenticity (E-E-A-T)
 * 100% Hindi / Devanagari interface matching the warm paper aesthetic.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = 'https://www.ashishvishwakarma.com/gyankosh/parichay';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': 'ज्ञानकोश परिचय — सनातन धर्मग्रंथों का पावन डिजिटल पुस्तकालय',
  'description': 'सनातन धर्मग्रंथों की शुचिता, शुद्ध पाठ और विज्ञापन-मुक्त एकाग्र स्वाध्याय के प्रति ज्ञानकोश का विनम्र संकल्प।',
  'url': canonicalUrl,
  'inLanguage': 'hi',
  'mainEntity': {
    '@type': 'Organization',
    'name': 'ज्ञानकोश',
    'url': 'https://www.ashishvishwakarma.com/gyankosh',
    'description': 'सनातन वैदिक एवं पौराणिक धर्मग्रंथों का पावन, विशुद्ध एवं विज्ञापन-मुक्त डिजिटल संग्रह।',
    'founder': {
      '@type': 'Person',
      'name': 'आशीष विश्वकर्मा (Ashish Vishwakarma)',
      'url': 'https://www.ashishvishwakarma.com',
    },
  },
};
---

<BaseLayout
  title="परिचय — ज्ञानकोश"
  description="सनातन धर्मग्रंथों की शुचिता, शुद्ध पाठ और विज्ञापन-मुक्त एकाग्र स्वाध्याय के प्रति ज्ञानकोश का विनम्र संकल्प।"
  canonical={canonicalUrl}
  jsonLd={jsonLd}
>
  <article class="parichay-page" aria-labelledby="parichay-heading">
    <div class="container parichay-container">
      
      <!-- Sacred Header -->
      <header class="parichay-header">
        <div class="parichay-invocation">॥ श्रीहरिः ॥</div>
        <h1 id="parichay-heading" class="parichay-title">ज्ञानकोश — एक विनम्र परिचय</h1>
        <p class="parichay-subtitle">डिजिटल युग में पवित्र ग्रंथों की शुचिता, शांति और एकाग्र स्वाध्याय</p>
      </header>

      <!-- Section 1: Mission & Story -->
      <section class="parichay-card" aria-labelledby="sec-mission">
        <div class="card-icon" aria-hidden="true">🪔</div>
        <h2 id="sec-mission" class="card-title">॥ यह प्रयास क्यों? — एक अंतर्मन की प्रेरणा ॥</h2>
        <p class="card-text">
          पूजा-पाठ, सन्ध्या-वन्दन अथवा चिन्तन के शांत क्षणों में जब भी किसी स्तोत्र, चालीसा या मन्त्र का पाठ करने का भाव जगता है और हम फोन उठाते हैं, तो प्रायः अनचाहे विज्ञापनों, चमकती-भटकाती स्क्रीन और अव्यवस्थित अक्षरों से चित्त विचलित हो जाता है। जिस पल मन को प्रभु के चरणों में स्थिर होना चाहिए, वह समय विज्ञापनों को हटाने और सही पंक्ति ढूँढने की खीझ में बीत जाता है।
        </p>
        <p class="card-text">
          यहीं से अंतर्मन को एक प्रेरणा मिली—<strong>क्या हमारे पूज्य धर्मग्रंथों को डिजिटल माध्यम में भी वही आदर और पवित्रता नहीं मिलनी चाहिए, जो घर के मंदिर में रेशमी वस्त्र में बँधे पवित्र ग्रंथों को मिलती है?</strong> इसी आस्था और निष्ठा से 'ज्ञानकोश' का बीजारोपण हुआ—एक ऐसा सात्विक और शांत कोना जहाँ कोई व्यावसायिक कोलाहल नहीं, कोई विज्ञापन नहीं; बस आप और ऋषियों की अमृतमयी वाणी।
        </p>
      </section>

      <!-- Section 2: Heritage & Tradition -->
      <section class="parichay-card" aria-labelledby="sec-authenticity">
        <div class="card-icon" aria-hidden="true">📜</div>
        <h2 id="sec-authenticity" class="card-title">॥ शाश्वत धरोहर — ऋषियों का पावन प्रसाद ॥</h2>
        <p class="card-text">
          ज्ञानकोश में संगृहीत वेद, उपनिषद्, गीता, स्तोत्र और पुराण किसी व्यक्ति या संस्था की निजी सम्पत्ति नहीं, बल्कि समस्त मानवता के कल्याणार्थ हमारे आर्ष ऋषियों और संत-मनीषियों की दिव्य देन हैं। सहस्रों वर्षों से चली आ रही यह ज्ञान-गंगा गुरु-शिष्य परम्परा और संतों की अखंड तपस्या के सहारे आज हम तक पहुँची है।
        </p>
        <p class="card-text">
          हम तो केवल सेतु बनने का एक लघु प्रयास कर रहे हैं—इस सनातन निधि को आधुनिक तकनीक के साथ इस प्रकार संजोना, जिससे हर साधक, जिज्ञासु और भावुक भक्त पूरी शुचिता के साथ इसका आचमन कर सके। यहाँ प्रस्तुत प्रत्येक पाठ उसी परम्परागत स्वरूप में है, जैसा हमारे पूर्वजों ने कंठस्थ किया और जो युगों से देवालयों व भारतीय घरों में गूँजता रहा है।
        </p>
      </section>

      <!-- Section 3: Devotion to Accuracy & Ease -->
      <section class="parichay-card" aria-labelledby="sec-editorial">
        <div class="card-icon" aria-hidden="true">✍️</div>
        <h2 id="sec-editorial" class="card-title">॥ पाठ की शुचिता एवं सुगम स्वाध्याय ॥</h2>
        <p class="card-text">
          संस्कृत और अवधी जैसी देवभाषाओं में एक अल्प-मात्रा, हलन्त अथवा विसर्ग का सूक्ष्म भेद भी अर्थ और भाव-स्पंदन को बदल देता है। इसलिए ज्ञानकोश में तकनीक को ग्रंथों पर थोपा नहीं गया, बल्कि पवित्र ग्रंथों के पावन पठन-सुख को स्क्रीन पर जीवंत करने का यत्न किया गया है:
        </p>
        <ul class="parichay-list">
          <li><strong>सहज अविरल स्क्रोल स्वाध्याय:</strong> आधुनिक पाठकों एवं नित्य साधकों की सुगमता हेतु सहज व निर्बाध स्क्रोल पठन, जिसमें श्लोक बीच में नहीं कटते और स्वाध्याय की निरंतरता व पठन-प्रगति स्वतः सुरक्षित रहती है।</li>
          <li><strong>पदों का स्वाभाविक विन्यास (छंद-विधान):</strong> श्लोकों और चौपाइयों के चरणों को इस प्रकार व्यवस्थित किया गया है कि पाठ करते समय लय, यति और श्वास का स्वाभाविक प्रवाह बना रहे।</li>
          <li><strong>शुद्ध देवनागरी संयुक्ताक्षर:</strong> मुद्रण और वर्तनी की त्रुटियों से मुक्त, स्पष्ट और सुपाठ्य पाठ—ताकि मन्त्रों के सस्वर उच्चारण में कोई संशय न रहे।</li>
          <li><strong>साधकों हेतु 'पाठ मोड':</strong> नित्य जप एवं साधना के समय केवल एक स्पर्श से अर्थ व व्याख्या को ओझल कर पूर्ण एकाग्रता के साथ मूल श्लोकों का पारायण किया जा सकता है।</li>
          <li><strong>सात्विक ग्रंथ-सज्जा एवं वैकल्पिक 3D पन्ना पलट:</strong> प्राचीन पवित्र ग्रंथों जैसी स्वर्णिम-पीत आभा और कुंकुम-रंगी किनारी। जो साधक वास्तविक ग्रंथों के पन्ने पलटने का अनुभव चाहते हैं, वे सेटिंग से 3D अथवा द्रुत (Lite) पन्ना-पलट शैली भी चुन सकते हैं।</li>
        </ul>
      </section>

      <!-- Section 4: Selfless Service -->
      <section class="parichay-card" aria-labelledby="sec-stewardship">
        <div class="card-icon" aria-hidden="true">🕉️</div>
        <h2 id="sec-stewardship" class="card-title">॥ निष्काम सेवा — न व्यापार, न स्वार्थ ॥</h2>
        <p class="card-text">
          ज्ञानकोश का सृजन <strong><a href="https://www.ashishvishwakarma.com" target="_blank" rel="noopener" class="author-link">आशीष विश्वकर्मा (Ashish Vishwakarma)</a></strong> द्वारा अपनी सांस्कृतिक जड़ों, पूर्वजों और ऋषि-ऋण के प्रति कृतज्ञता-ज्ञापन का एक विनम्र प्रयास है।
        </p>
        <p class="card-text">
          यह न तो कोई व्यावसायिक उपक्रम है और न ही किसी लाभ की आकांक्षा। संकल्प केवल इतना है कि आज की नई पीढ़ी और विश्वभर में फैले सनातन अनुरागी जब भी अपनी जड़ों और आध्यात्मिक ज्ञान से जुड़ना चाहें, तो उन्हें एक ऐसा शुद्ध, निश्छल और विज्ञापन-रहित आश्रय मिले जहाँ केवल सत्य, शुचिता और श्रद्धा का वास हो।
        </p>
      </section>

      <!-- Section 5: Corrections & Community -->
      <section class="parichay-card" aria-labelledby="sec-feedback">
        <div class="card-icon" aria-hidden="true">🙏</div>
        <h2 id="sec-feedback" class="card-title">॥ मानवीय सीमाएँ एवं आपका सहयोग ॥</h2>
        <p class="card-text">
          विशाल शास्त्र-समुद्र की तुलना में हमारा यह प्रयास अंजलि-भर जल के समान है। इतने विपुल और गूढ़ साहित्य के डिजिटलीकरण में पूरी निष्ठा के बावजूद कहीं मात्रा, वर्तनी अथवा पाठ-भेद की त्रुटि का रह जाना सर्वथा स्वाभाविक है।
        </p>
        <p class="card-text">
          यदि स्वाध्याय के समय आपकी दृष्टि में कोई भी त्रुटि आए, तो इसे पराया न मानकर हमें अवश्य अवगत कराएँ। एक सहृदय सुधीजन की भाँति दिया गया आपका परामर्श हमारे लिए शिरोधार्य होगा और इस पावन ग्रंथ-संग्रह को और अधिक निर्मल व प्रामाणिक बनाएगा।
        </p>
        <div class="feedback-action-box">
          <a href="https://github.com/AshV/gyankosh/issues" target="_blank" rel="noopener" class="btn-feedback">
            <span>📝</span> त्रुटि अथवा सुझाव भेजें (GitHub)
          </a>
          <a href={`${base}/`} class="btn-back-home">
            <span>📖</span> मुख्य ग्रंथागार (पुस्तकालय)
          </a>
        </div>
      </section>

    </div>
  </article>
</BaseLayout>

<style>
  .parichay-page {
    padding: 2rem 1rem 4rem;
    font-family: var(--font-devanagari);
  }

  .parichay-container {
    max-width: 780px;
    margin: 0 auto;
  }

  .parichay-header {
    text-align: center;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .parichay-invocation {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .parichay-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .parichay-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .parichay-card {
    background: var(--color-bg-card);
    background-image: 
      radial-gradient(ellipse at 50% 10%, rgba(255, 252, 245, 0.98), rgba(248, 241, 226, 0.98)),
      linear-gradient(to bottom, rgba(0,0,0,0.02) 0%, transparent 10%);
    border: 2px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem 1.75rem;
    margin-bottom: 2rem;
    box-shadow: 
      0 4px 15px rgba(60, 35, 15, 0.08),
      0 1px 3px rgba(60, 35, 15, 0.05);
    position: relative;
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0 0 1rem;
  }

  .card-text {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }

  .card-text:last-child {
    margin-bottom: 0;
  }

  .parichay-list {
    margin: 0 0 1rem 1.25rem;
    padding: 0;
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--color-ink);
  }

  .parichay-list li {
    margin-bottom: 0.6rem;
  }

  .author-link {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .author-link:hover {
    color: var(--color-gold);
  }

  .feedback-action-box {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-feedback, .btn-back-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-devanagari);
    font-size: 1rem;
    font-weight: 700;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-feedback {
    background: var(--color-accent);
    color: #ffffff;
  }

  .btn-feedback:hover {
    background: color-mix(in hsl, var(--color-accent), black 15%);
    transform: translateY(-1px);
  }

  .btn-back-home {
    background: transparent;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
  }

  .btn-back-home:hover {
    background: rgba(142, 27, 20, 0.08);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .parichay-title {
      font-size: 1.6rem;
    }
    .parichay-card {
      padding: 1.25rem 1.1rem;
    }
    .card-title {
      font-size: 1.15rem;
    }
    .card-text, .parichay-list {
      font-size: 0.98rem;
    }
  }
</style>
