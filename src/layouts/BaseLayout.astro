---
/**
 * BaseLayout.astro
 * Gyankosh Sacred Indic Paper Book Layout Shell
 */
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import SearchModal from '../components/SearchModal.astro';
import SacredLoader from '../components/SacredLoader.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  author?: string;
  image?: string;
  keywords?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  author,
  image,
  keywords = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="hi" dir="ltr">
  <head>
    <!-- Seamless Domain & Legacy Subpath Forwarding -->
    <script is:inline>
      (function () {
        try {
          var loc = window.location;
          var host = loc.hostname.toLowerCase();
          var path = loc.pathname;
          var targetDomain = 'gyankosh.app';

          var isLegacyHost = host === 'www.ashishvishwakarma.com' ||
                             host === 'ashishvishwakarma.com' ||
                             host === 'ashv.github.io' ||
                             host.endsWith('.github.io');

          var hasLegacyPath = path === '/gyankosh' || path.indexOf('/gyankosh/') === 0;

          if (isLegacyHost || hasLegacyPath) {
            var cleanPath = path;
            if (hasLegacyPath) {
              cleanPath = path.replace(/^\/gyankosh(?:\/|$)/, '/');
              if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;
            }
            var targetHost = (isLegacyHost || host === targetDomain) ? targetDomain : host;
            var targetUrl = 'https://' + targetHost + cleanPath + loc.search + loc.hash;
            if (loc.href !== targetUrl) {
              loc.replace(targetUrl);
            }
          }
        } catch (e) {}
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#8e1b14" id="theme-color-meta" />
    <meta name="color-scheme" content="light" id="color-scheme-meta" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ज्ञानकोश" />
    <meta name="application-name" content="ज्ञानकोश" />

    <!-- Web App Manifest -->
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />

    <!-- Favicons & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="shortcut icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />

    <!-- RSS Feed Autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="ज्ञानकोश RSS" href={`${base}/rss.xml`} />

    <!-- Restore theme preference immediately before paint (Default: always light for new users) -->
    <script is:inline>
      (function () {
        var prefs = {};
        try { prefs = JSON.parse(localStorage.getItem('gyankosh_prefs') || '{}'); } catch(e) {}
        if (prefs.nightMode === true) {
          document.documentElement.classList.add('reader-night-mode');
          var colorSchemeMeta = document.getElementById('color-scheme-meta');
          if (colorSchemeMeta) colorSchemeMeta.content = 'dark';
          var themeColorMeta = document.getElementById('theme-color-meta');
          if (themeColorMeta) themeColorMeta.content = '#151210';
        } else {
          document.documentElement.classList.remove('reader-night-mode');
        }
      })();
    </script>


    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      author={author}
      image={image}
      keywords={keywords}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>

  <body>
    <!-- Sacred Universal Loader -->
    <SacredLoader />

    <!-- Shared SVG Icon Symbols (Rendered once, referenced via <use>) -->
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;" aria-hidden="true">
      <defs>
        <symbol id="icon-bookmark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </symbol>
        <symbol id="icon-share" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </symbol>
        <symbol id="icon-chevron-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </symbol>
      </defs>
    </svg>

    <!-- Site Header -->
    <header class="site-header" role="banner">
      <div class="container">
        <a href={`${base}/`} class="site-logo" aria-label="ज्ञानकोश मुख्य पृष्ठ">
          <img
            src={`${base}/logo.png`}
            alt=""
            width="38"
            height="38"
            class="site-logo-img"
            loading="eager"
            decoding="async"
          />
          <span>ज्ञानकोश</span>
        </a>

        <nav role="navigation" aria-label="मुख्य अनुभाग">
          <ul class="site-nav-list">
            <li><a href={`${base}/category/veda`} class="site-nav-link">वेद</a></li>
            <li><a href={`${base}/category/upanishad`} class="site-nav-link">उपनिषद्</a></li>
            <li><a href={`${base}/category/gita`} class="site-nav-link">गीता</a></li>
            <li><a href={`${base}/category/chalisa`} class="site-nav-link">चालीसा</a></li>
            <li><a href={`${base}/category/stotra`} class="site-nav-link">स्तोत्र</a></li>
            <li><a href={`${base}/category/aarti`} class="site-nav-link">आरती</a></li>
            <li><a href={`${base}/category/purana`} class="site-nav-link">पुराण</a></li>
          </ul>
        </nav>
        <div class="header-right-actions">
          <!-- Parichay Quick Link (Always accessible on mobile & desktop) -->
          <a
            href={`${base}/parichay`}
            class="header-action-btn header-parichay-btn"
            aria-label="ज्ञानकोश परिचय एवं सम्पादकीय"
            title="ज्ञानकोश परिचय"
          >
            <span class="action-btn-icon" aria-hidden="true">📖</span>
            <span class="action-btn-text sr-only">परिचय</span>
          </a>

          <!-- Theme Toggle -->
          <button
            type="button"
            id="global-theme-toggle"
            class="header-action-btn"
            aria-label="थीम बदलें"
            title="दिवस/रात्रि मोड"
          >
            <span class="action-btn-icon" aria-hidden="true" id="global-theme-icon">☀️</span>
            <span class="action-btn-text sr-only">थीम</span>
          </button>

          <!-- Share Page Button -->
          <button
            type="button"
            id="header-share-app-btn"
            class="header-action-btn header-share-btn"
            aria-label="यह पृष्ठ साझा करें"
            title="साझा करें"
          >
            <svg class="header-share-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
            <span class="action-btn-text sr-only">साझा करें</span>
          </button>

          <button
            type="button"
            id="header-pwa-install-btn"
            class="header-install-btn"
            style="display:none;"
            aria-label="ज्ञानकोश ऐप इंस्टॉल करें"
            title="ज्ञानकोश ऐप इंस्टॉल करें"
          >
            <span class="install-btn-icon" aria-hidden="true">📲</span>
            <span class="install-btn-text">ऐप इंस्टॉल करें</span>
          </button>

          <button
            type="button"
            id="header-search-trigger"
            class="header-search-btn"
            aria-label="ग्रंथ खोजें (Ctrl+K)"
            title="ग्रंथ खोजें (Ctrl+K / ⌘K)"
          >
            <svg class="search-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main id="main-content" role="main">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer
      role="contentinfo"
      style="padding:2.5rem 1rem;text-align:center;font-family:var(--font-devanagari);font-size:0.9rem;color:var(--color-text-muted);border-top:2px solid var(--color-border);margin-top:3rem;background:var(--color-bg-elevated);"
    >
      <p style="color:var(--color-accent);font-weight:700;margin-bottom:0.25rem;">॥ श्रीहरिः ॥</p>
      <p style="margin-bottom:0.5rem;">ज्ञानकोश — सनातन वैदिक एवं पौराणिक धर्मग्रंथों का डिजिटल संग्रह</p>
      <p style="font-size:0.85rem;">
        <a href={`${base}/parichay`} style="color:var(--color-accent);text-decoration:none;font-weight:600;">परिचय एवं सम्पादकीय प्रामाणिकता</a>
        <span aria-hidden="true" style="margin: 0 0.5rem; opacity: 0.5;">•</span>
        <span>सार्वजनिक कार्यक्षेत्र (Public Domain)</span>
        <span id="footer-install-separator" aria-hidden="true" style="display:none; margin: 0 0.5rem; opacity: 0.5;">•</span>
        <button
          type="button"
          id="footer-pwa-install-btn"
          class="footer-install-btn"
          style="display:none; background:none; border:none; color:var(--color-accent); font-family:var(--font-devanagari); font-size:0.85rem; font-weight:600; cursor:pointer; padding:0; text-decoration:underline;"
        >
          📲 ऐप इंस्टॉल करें
        </button>
      </p>
    </footer>

    <!-- Site-wide Quick Search Modal -->
    <SearchModal />

    <!-- Floating PWA Install Banner -->
    <aside id="pwa-install-banner" class="pwa-install-banner" aria-label="ज्ञानकोश ऐप इंस्टॉल करें" style="display:none;">
      <div class="pwa-banner-inner">
        <div class="pwa-banner-logo-wrap">
          <img
            src={`${base}/logo.png`}
            alt="ज्ञानकोश"
            width="44"
            height="44"
            class="pwa-banner-logo"
            loading="lazy"
          />
        </div>
        <div class="pwa-banner-content">
          <div class="pwa-banner-title">ज्ञानकोश ऐप इंस्टॉल करें</div>
          <div class="pwa-banner-desc">ऑफ़लाइन स्वाध्याय, तीव्र गति एवं पूर्ण स्क्रीन अनुभव के लिए</div>
        </div>
        <div class="pwa-banner-actions">
          <button type="button" id="pwa-banner-install-btn" class="pwa-btn-primary">
            📲 इंस्टॉल करें
          </button>
          <button
            type="button"
            id="pwa-banner-close-btn"
            class="pwa-btn-dismiss"
            aria-label="सूचना बंद करें"
            title="बाद में"
          >
            ✕
          </button>
        </div>
      </div>
    </aside>

    <!-- iOS Safari Installation Guide Modal -->
    <dialog id="pwa-ios-modal" class="pwa-ios-modal" aria-labelledby="pwa-ios-title">
      <div class="pwa-ios-content">
        <div class="pwa-ios-header">
          <div class="pwa-ios-header-left">
            <img src={`${base}/logo.png`} alt="" width="36" height="36" class="pwa-ios-logo" />
            <h3 id="pwa-ios-title" class="pwa-ios-title">ज्ञानकोश को होम स्क्रीन पर जोड़ें</h3>
          </div>
          <button type="button" id="pwa-ios-close-btn" class="pwa-ios-close" aria-label="बंद करें">✕</button>
        </div>
        <p class="pwa-ios-intro">Safari ब्राउज़र में ज्ञानकोश को मोबाइल ऐप की तरह प्रयोग करने के सरल चरण:</p>
        <ol class="pwa-ios-steps">
          <li>
            <span class="step-num">१</span>
            <div class="step-desc">
              सफ़ारी के नीचे दिए गए <strong>शेयर बटन</strong> (<span class="ios-icon" aria-label="शेयर">⎋</span> Share) पर टैप करें।
            </div>
          </li>
          <li>
            <span class="step-num">२</span>
            <div class="step-desc">
              मेनू में नीचे स्क्रॉल करके <strong>'होम स्क्रीन में जोड़ें'</strong> (<span class="ios-icon" aria-label="जोड़ें">⊞</span> Add to Home Screen) चुनें।
            </div>
          </li>
          <li>
            <span class="step-num">३</span>
            <div class="step-desc">
              ऊपर दाईं ओर <strong>'जोड़ें'</strong> (Add) दबाएं। ज्ञानकोश का दिव्य प्रतीक आपकी स्क्रीन पर स्थापित हो जाएगा।
            </div>
          </li>
        </ol>
        <div class="pwa-ios-footer">
          <button type="button" id="pwa-ios-done-btn" class="pwa-btn-primary" style="width:100%;">समझ गया</button>
        </div>
      </div>
    </dialog>

    <script src="../scripts/app.ts"></script>
  </body>
</html>
