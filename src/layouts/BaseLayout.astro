---
/**
 * BaseLayout.astro
 * Gyankosh Sacred Indic Paper Book Layout Shell
 */
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import SearchModal from '../components/SearchModal.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  author?: string;
  image?: string;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  author,
  image,
  keywords = [],
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="hi" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#8e1b14" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ज्ञानकोश" />
    <meta name="application-name" content="ज्ञानकोश" />

    <!-- Web App Manifest -->
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />

    <!-- Favicons & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="shortcut icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />

    <!-- RSS Feed Autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="ज्ञानकोश RSS" href={`${base}/rss.xml`} />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      author={author}
      image={image}
      keywords={keywords}
      jsonLd={jsonLd}
    />
  </head>

  <body>
    <!-- Site Header -->
    <header class="site-header" role="banner">
      <div class="container">
        <a href={`${base}/`} class="site-logo" aria-label="ज्ञानकोश मुख्य पृष्ठ">
          <img
            src={`${base}/logo.png`}
            alt=""
            width="38"
            height="38"
            class="site-logo-img"
            loading="eager"
            decoding="async"
          />
          <span>ज्ञानकोश</span>
        </a>

        <nav role="navigation" aria-label="मुख्य अनुभाग">
          <ul style="display:flex; gap:1.15rem; list-style:none; align-items:center; flex-wrap:wrap;">
            <li><a href={`${base}/category/veda`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">वेद</a></li>
            <li><a href={`${base}/category/upanishad`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">उपनिषद्</a></li>
            <li><a href={`${base}/category/gita`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">गीता</a></li>
            <li><a href={`${base}/category/chalisa`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">चालीसा</a></li>
            <li><a href={`${base}/category/stotra`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">स्तोत्र</a></li>
            <li><a href={`${base}/category/aarti`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">आरती</a></li>
            <li><a href={`${base}/category/purana`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">पुराण</a></li>
            <li><a href={`${base}/parichay`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">परिचय</a></li>
          </ul>
        </nav>
        <div class="header-right-actions" style="display:flex; align-items:center; gap:0.75rem;">
          <button
            type="button"
            id="header-search-trigger"
            class="header-search-btn"
            aria-label="ग्रंथ खोजें (Ctrl+K)"
            title="ग्रंथ खोजें (Ctrl+K / ⌘K)"
          >
            <span class="search-btn-icon" aria-hidden="true">🔍</span>
            <span class="search-btn-text">खोजें</span>
            <kbd class="search-btn-kbd">⌘K</kbd>
          </button>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main id="main-content" role="main">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer
      role="contentinfo"
      style="padding:2.5rem 1rem;text-align:center;font-family:var(--font-devanagari);font-size:0.9rem;color:var(--color-text-muted);border-top:2px solid var(--color-border);margin-top:3rem;background:var(--color-bg-elevated);"
    >
      <p style="color:var(--color-accent);font-weight:700;margin-bottom:0.25rem;">॥ श्रीहरिः ॥</p>
      <p style="margin-bottom:0.5rem;">ज्ञानकोश — सनातन वैदिक एवं पौराणिक धर्मग्रंथों का डिजिटल संग्रह</p>
      <p style="font-size:0.85rem;">
        <a href={`${base}/parichay`} style="color:var(--color-accent);text-decoration:none;font-weight:600;">परिचय एवं सम्पादकीय प्रामाणिकता</a>
        <span aria-hidden="true" style="margin: 0 0.5rem; opacity: 0.5;">•</span>
        <span>सार्वजनिक कार्यक्षेत्र (Public Domain)</span>
      </p>
    </footer>

    <!-- Site-wide Quick Search Modal -->
    <SearchModal />

    <script is:inline define:vars={{ base }}>
      document.getElementById('header-search-trigger')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('gyankosh:open-search'));
      });

      // PWA Service Worker Registration
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${base}/sw.js`, { scope: `${base}/` })
            .catch((err) => {
              console.warn('[Gyankosh PWA] Service Worker registration failed:', err);
            });
        });
      }
    </script>
  </body>
</html>
