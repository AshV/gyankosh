---
/**
 * BaseLayout.astro
 * Gyankosh Sacred Indic Paper Book Layout Shell
 */
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import SearchModal from '../components/SearchModal.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  author?: string;
  image?: string;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  author,
  image,
  keywords = [],
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="hi" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#8e1b14" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ज्ञानकोश" />
    <meta name="application-name" content="ज्ञानकोश" />

    <!-- Web App Manifest -->
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />

    <!-- Favicons & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="shortcut icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />

    <!-- RSS Feed Autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="ज्ञानकोश RSS" href={`${base}/rss.xml`} />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      author={author}
      image={image}
      keywords={keywords}
      jsonLd={jsonLd}
    />
  </head>

  <body>
    <!-- Site Header -->
    <header class="site-header" role="banner">
      <div class="container">
        <a href={`${base}/`} class="site-logo" aria-label="ज्ञानकोश मुख्य पृष्ठ">
          <img
            src={`${base}/logo.png`}
            alt=""
            width="38"
            height="38"
            class="site-logo-img"
            loading="eager"
            decoding="async"
          />
          <span>ज्ञानकोश</span>
        </a>

        <nav role="navigation" aria-label="मुख्य अनुभाग">
          <ul style="display:flex; gap:1.15rem; list-style:none; align-items:center; flex-wrap:wrap;">
            <li><a href={`${base}/category/veda`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">वेद</a></li>
            <li><a href={`${base}/category/upanishad`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">उपनिषद्</a></li>
            <li><a href={`${base}/category/gita`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">गीता</a></li>
            <li><a href={`${base}/category/chalisa`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">चालीसा</a></li>
            <li><a href={`${base}/category/stotra`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">स्तोत्र</a></li>
            <li><a href={`${base}/category/aarti`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">आरती</a></li>
            <li><a href={`${base}/category/purana`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">पुराण</a></li>
            <li><a href={`${base}/parichay`} style="font-family:var(--font-devanagari);font-size:1rem;font-weight:600;color:var(--color-accent);">परिचय</a></li>
          </ul>
        </nav>
        <div class="header-right-actions" style="display:flex; align-items:center; gap:0.75rem;">
          <button
            type="button"
            id="header-pwa-install-btn"
            class="header-install-btn"
            style="display:none;"
            aria-label="ज्ञानकोश ऐप इंस्टॉल करें"
            title="ज्ञानकोश ऐप इंस्टॉल करें"
          >
            <span class="install-btn-icon" aria-hidden="true">📲</span>
            <span class="install-btn-text">ऐप इंस्टॉल करें</span>
          </button>
          <button
            type="button"
            id="header-search-trigger"
            class="header-search-btn"
            aria-label="ग्रंथ खोजें (Ctrl+K)"
            title="ग्रंथ खोजें (Ctrl+K / ⌘K)"
          >
            <span class="search-btn-icon" aria-hidden="true">🔍</span>
            <span class="search-btn-text">खोजें</span>
            <kbd class="search-btn-kbd">⌘K</kbd>
          </button>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main id="main-content" role="main">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer
      role="contentinfo"
      style="padding:2.5rem 1rem;text-align:center;font-family:var(--font-devanagari);font-size:0.9rem;color:var(--color-text-muted);border-top:2px solid var(--color-border);margin-top:3rem;background:var(--color-bg-elevated);"
    >
      <p style="color:var(--color-accent);font-weight:700;margin-bottom:0.25rem;">॥ श्रीहरिः ॥</p>
      <p style="margin-bottom:0.5rem;">ज्ञानकोश — सनातन वैदिक एवं पौराणिक धर्मग्रंथों का डिजिटल संग्रह</p>
      <p style="font-size:0.85rem;">
        <a href={`${base}/parichay`} style="color:var(--color-accent);text-decoration:none;font-weight:600;">परिचय एवं सम्पादकीय प्रामाणिकता</a>
        <span aria-hidden="true" style="margin: 0 0.5rem; opacity: 0.5;">•</span>
        <span>सार्वजनिक कार्यक्षेत्र (Public Domain)</span>
        <span id="footer-install-separator" aria-hidden="true" style="display:none; margin: 0 0.5rem; opacity: 0.5;">•</span>
        <button
          type="button"
          id="footer-pwa-install-btn"
          class="footer-install-btn"
          style="display:none; background:none; border:none; color:var(--color-accent); font-family:var(--font-devanagari); font-size:0.85rem; font-weight:600; cursor:pointer; padding:0; text-decoration:underline;"
        >
          📲 ऐप इंस्टॉल करें
        </button>
      </p>
    </footer>

    <!-- Site-wide Quick Search Modal -->
    <SearchModal />

    <!-- Floating PWA Install Banner -->
    <aside id="pwa-install-banner" class="pwa-install-banner" aria-label="ज्ञानकोश ऐप इंस्टॉल करें" style="display:none;">
      <div class="pwa-banner-inner">
        <div class="pwa-banner-logo-wrap">
          <img
            src={`${base}/logo.png`}
            alt="ज्ञानकोश"
            width="44"
            height="44"
            class="pwa-banner-logo"
            loading="lazy"
          />
        </div>
        <div class="pwa-banner-content">
          <div class="pwa-banner-title">ज्ञानकोश ऐप इंस्टॉल करें</div>
          <div class="pwa-banner-desc">ऑफ़लाइन स्वाध्याय, तीव्र गति एवं पूर्ण स्क्रीन अनुभव के लिए</div>
        </div>
        <div class="pwa-banner-actions">
          <button type="button" id="pwa-banner-install-btn" class="pwa-btn-primary">
            📲 इंस्टॉल करें
          </button>
          <button
            type="button"
            id="pwa-banner-close-btn"
            class="pwa-btn-dismiss"
            aria-label="सूचना बंद करें"
            title="बाद में"
          >
            ✕
          </button>
        </div>
      </div>
    </aside>

    <!-- iOS Safari Installation Guide Modal -->
    <dialog id="pwa-ios-modal" class="pwa-ios-modal" aria-labelledby="pwa-ios-title">
      <div class="pwa-ios-content">
        <div class="pwa-ios-header">
          <div class="pwa-ios-header-left">
            <img src={`${base}/logo.png`} alt="" width="36" height="36" class="pwa-ios-logo" />
            <h3 id="pwa-ios-title" class="pwa-ios-title">ज्ञानकोश को होम स्क्रीन पर जोड़ें</h3>
          </div>
          <button type="button" id="pwa-ios-close-btn" class="pwa-ios-close" aria-label="बंद करें">✕</button>
        </div>
        <p class="pwa-ios-intro">Safari ब्राउज़र में ज्ञानकोश को मोबाइल ऐप की तरह प्रयोग करने के सरल चरण:</p>
        <ol class="pwa-ios-steps">
          <li>
            <span class="step-num">१</span>
            <div class="step-desc">
              सफ़ारी के नीचे दिए गए <strong>शेयर बटन</strong> (<span class="ios-icon" aria-label="शेयर">⎋</span> Share) पर टैप करें।
            </div>
          </li>
          <li>
            <span class="step-num">२</span>
            <div class="step-desc">
              मेनू में नीचे स्क्रॉल करके <strong>'होम स्क्रीन में जोड़ें'</strong> (<span class="ios-icon" aria-label="जोड़ें">⊞</span> Add to Home Screen) चुनें।
            </div>
          </li>
          <li>
            <span class="step-num">३</span>
            <div class="step-desc">
              ऊपर दाईं ओर <strong>'जोड़ें'</strong> (Add) दबाएं। ज्ञानकोश का दिव्य प्रतीक आपकी स्क्रीन पर स्थापित हो जाएगा।
            </div>
          </li>
        </ol>
        <div class="pwa-ios-footer">
          <button type="button" id="pwa-ios-done-btn" class="pwa-btn-primary" style="width:100%;">समझ गया</button>
        </div>
      </div>
    </dialog>

    <script is:inline define:vars={{ base }}>
      document.getElementById('header-search-trigger')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('gyankosh:open-search'));
      });

      // PWA Service Worker Registration
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${base}/sw.js`, { scope: `${base}/` })
            .catch((err) => {
              console.warn('[Gyankosh PWA] Service Worker registration failed:', err);
            });
        });
      }

      // PWA Installation Handling
      (function initPWA() {
        const isStandalone = window.matchMedia('(display-mode: standalone)').matches ||
                             window.navigator.standalone === true;
        if (isStandalone) return;

        const isIOS = /iphone|ipad|ipod/.test(window.navigator.userAgent.toLowerCase()) && !window.MSStream;

        let deferredPrompt = null;
        const headerBtn = document.getElementById('header-pwa-install-btn');
        const footerBtn = document.getElementById('footer-pwa-install-btn');
        const footerSep = document.getElementById('footer-install-separator');
        const banner = document.getElementById('pwa-install-banner');
        const bannerInstallBtn = document.getElementById('pwa-banner-install-btn');
        const bannerCloseBtn = document.getElementById('pwa-banner-close-btn');
        const iosModal = document.getElementById('pwa-ios-modal');
        const iosCloseBtn = document.getElementById('pwa-ios-close-btn');
        const iosDoneBtn = document.getElementById('pwa-ios-done-btn');

        function openIOSModal() {
          if (iosModal && typeof iosModal.showModal === 'function') {
            iosModal.showModal();
          }
        }

        function closeIOSModal() {
          if (iosModal && typeof iosModal.close === 'function') {
            iosModal.close();
          }
        }

        iosCloseBtn?.addEventListener('click', closeIOSModal);
        iosDoneBtn?.addEventListener('click', closeIOSModal);
        iosModal?.addEventListener('click', (e) => {
          if (e.target === iosModal) closeIOSModal();
        });

        function showInstallUI() {
          if (headerBtn) headerBtn.style.display = 'inline-flex';
          if (footerBtn) footerBtn.style.display = 'inline';
          if (footerSep) footerSep.style.display = 'inline';

          // Show floating banner if not dismissed in last 7 days
          const dismissedAt = localStorage.getItem('gyankosh_pwa_dismissed');
          const now = Date.now();
          const sevenDays = 7 * 24 * 60 * 60 * 1000;
          if (!dismissedAt || (now - Number(dismissedAt)) > sevenDays) {
            setTimeout(() => {
              if (banner) {
                banner.style.display = 'block';
                banner.offsetHeight; // trigger reflow
                banner.classList.add('is-visible');
              }
            }, 1800);
          }
        }

        function hideInstallUI() {
          if (headerBtn) headerBtn.style.display = 'none';
          if (footerBtn) footerBtn.style.display = 'none';
          if (footerSep) footerSep.style.display = 'none';
          if (banner) {
            banner.classList.remove('is-visible');
            setTimeout(() => { banner.style.display = 'none'; }, 400);
          }
        }

        async function handleInstallTrigger() {
          if (deferredPrompt) {
            deferredPrompt.prompt();
            try {
              const choice = await deferredPrompt.userChoice;
              if (choice && choice.outcome === 'accepted') {
                hideInstallUI();
              }
            } catch (err) {
              console.warn('[PWA] Prompt error:', err);
            }
            deferredPrompt = null;
          } else if (isIOS) {
            openIOSModal();
          } else {
            // For desktop/browsers where prompt is available via browser menu
            openIOSModal();
          }
        }

        headerBtn?.addEventListener('click', handleInstallTrigger);
        bannerInstallBtn?.addEventListener('click', handleInstallTrigger);
        footerBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          handleInstallTrigger();
        });

        bannerCloseBtn?.addEventListener('click', () => {
          localStorage.setItem('gyankosh_pwa_dismissed', String(Date.now()));
          if (banner) {
            banner.classList.remove('is-visible');
            setTimeout(() => { banner.style.display = 'none'; }, 400);
          }
        });

        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredPrompt = e;
          showInstallUI();
        });

        window.addEventListener('appinstalled', () => {
          hideInstallUI();
          deferredPrompt = null;
          console.log('[Gyankosh PWA] App installed successfully');
        });

        if (isIOS) {
          showInstallUI();
        }
      })();
    </script>
  </body>
</html>
