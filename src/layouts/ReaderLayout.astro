---
/**
 * ReaderLayout.astro
 * Gyankosh Sacred Pothi Paper Book E-Reader
 *
 * Visual & Typographic Identity:
 * - Single authentic sacred paper book theme (off-white warm paper, red border frames, rich black ink).
 * - 3D Vertical Page-Flip Animation (पन्ना पलट).
 * - Running page header: ॥ ग्रंथ शीर्षक ॥
 * - Devanagari numerals and traditional sacred speaker / verse markers.
 * - Sacred Aarambh cover screen with album artwork and fullscreen entry on start.
 */
import '../styles/global.css';
import '../styles/reader.css';
import SEO from '../components/SEO.astro';
import { tagToSlug } from '../utils/tags';
import { getCategoryLabel } from '../data/categoryMeta';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  author?: string;
  language?: string;
  category?: string;
  coverColor?: string;
  coverImage?: string;
  slug: string;
  image?: string;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  showNumbering?: boolean;
  tags?: string[];
  context?: string;
  seoTitle?: string;
}

const {
  title,
  seoTitle,
  description,
  canonical = Astro.url.href,
  author,
  language = 'Sanskrit',
  category,
  coverColor = 'hsl(22, 85%, 45%)',
  coverImage,
  slug,
  image,
  keywords = [],
  jsonLd,
  showNumbering = true,
  tags = [],
  context,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const resolvedCoverImage = coverImage
  ? (coverImage.startsWith('http') ? coverImage : `${base}${coverImage.startsWith('/') ? '' : '/'}${coverImage}`)
  : `${base}/covers/${slug}.webp`;

const resolvedWebpImage = resolvedCoverImage.endsWith('.jpg')
  ? resolvedCoverImage.replace(/\.jpg$/, '.webp')
  : resolvedCoverImage;

const resolvedJpgImage = resolvedCoverImage.endsWith('.webp')
  ? resolvedCoverImage.replace(/\.webp$/, '.jpg')
  : resolvedCoverImage;

const ogImage = image || (coverImage
  ? (coverImage.startsWith('http') ? coverImage : `https://www.ashishvishwakarma.com${base}${coverImage.startsWith('/') ? '' : '/'}${coverImage}`.replace(/\.webp$/, '.jpg'))
  : `https://www.ashishvishwakarma.com${base}/covers/${slug}.jpg`);
---

<!doctype html>
<html lang="hi" dir="ltr" class={!showNumbering ? 'hide-numbering' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#8e1b14" id="theme-color-meta" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ज्ञानकोश" />
    <meta name="application-name" content="ज्ञानकोश" />

    <!-- Web App Manifest -->
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />

    <!-- Favicons & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="shortcut icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <SEO
      title={seoTitle || title}
      description={description}
      canonical={canonical}
      author={author}
      language={language}
      type="book"
      image={ogImage}
      keywords={keywords}
      jsonLd={jsonLd}
    />

    <!-- Restore user font preferences immediately before paint -->
    <script is:inline define:vars={{ defaultShowNumbering: showNumbering }}>
      (function () {
        var prefs = {};
        try { prefs = JSON.parse(localStorage.getItem('gyankosh_prefs') || '{}'); } catch(e) {}
        var fontSize = prefs.fontSize || '1.15';
        var lineHeight = prefs.lineHeight || '2.0';
        document.documentElement.style.setProperty('--reader-font-size', fontSize + 'rem');
        document.documentElement.style.setProperty('--reader-line-height', lineHeight);
        var hide = prefs.hideNumbering !== undefined ? prefs.hideNumbering : !defaultShowNumbering;
        if (hide) {
          document.documentElement.classList.add('hide-numbering');
        } else {
          document.documentElement.classList.remove('hide-numbering');
        }
        var isChanting = prefs.chanting !== undefined ? prefs.chanting : true;
        if (isChanting) {
          document.documentElement.classList.add('chanting-mode');
        } else {
          document.documentElement.classList.remove('chanting-mode');
        }

        // Night / Dark Mode
        if (prefs.nightMode) {
          document.documentElement.classList.add('reader-night-mode');
        } else {
          document.documentElement.classList.remove('reader-night-mode');
        }

        // Reading Mode: 'scroll' (default) | '3d' | 'lite'
        var readingMode = prefs.readingMode || 'scroll';
        if (readingMode === 'scroll') {
          document.documentElement.classList.add('reader-scroll-mode');
          document.documentElement.classList.remove('reader-lite-mode');
        } else {
          document.documentElement.classList.remove('reader-scroll-mode');
          // Conditional device capability detection for animations (3D vs Lite)
          var animPref = readingMode; // '3d' | 'lite'
          var isLite = false;
          if (animPref === 'lite') {
            isLite = true;
          } else if (animPref === '3d') {
            isLite = false;
          } else {
            // Automatic detection based on device hardware and preferences
            var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var isSaveData = navigator.connection && navigator.connection.saveData === true;
            var isLowMemory = typeof navigator.deviceMemory === 'number' && navigator.deviceMemory <= 3;
            var isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent || '');
            var isLowCpu = typeof navigator.hardwareConcurrency === 'number' && isMobile && navigator.hardwareConcurrency <= 4;
            if (prefersReducedMotion || isSaveData || isLowMemory || isLowCpu) {
              isLite = true;
            }
          }
          if (isLite) {
            document.documentElement.classList.add('reader-lite-mode');
          } else {
            document.documentElement.classList.remove('reader-lite-mode');
          }
        }
      })();
    </script>
  </head>

  <body class={`${!showNumbering ? 'hide-numbering' : ''} chanting-mode has-cover-screen`}>
    <!-- Sacred Red/Gold Reading Progress Bar -->
    <div id="reading-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="पठन प्रगति"></div>

    <!-- Reader Shell -->
    <div
      id="reader-shell"
      class="reader-shell has-cover-screen"
      data-slug={slug}
      data-book-title={title}
      data-base={base}
    >

      <!-- Top Bar -->
      <header class="reader-topbar" role="banner">
        <a href={category ? `${base}/category/${category.toLowerCase()}` : `${base}/`} class="back-link" id="reader-back-btn" aria-label="वापस जाएं" title="वापस जाएं">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          <span>ज्ञानकोश</span>
        </a>

        <div class="topbar-actions">
          <!-- Table of Contents / विषय सूची Button -->
          <button
            id="reader-toc-btn"
            class="icon-btn topbar-btn--toc"
            aria-label="विषय सूची"
            title="विषय सूची (पदों की सूची)"
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            <!-- Sacred List / Index Icon -->
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
          </button>

          <!-- Night / Dark Mode Toggle (रात्रि मोड) -->
          <button
            id="night-mode-toggle"
            class="icon-btn topbar-btn--night"
            aria-label="रात्रि पठन मोड"
            title="रात्रि मोड — नेत्र-सुखद गहरा काष्ठ"
            aria-pressed="false"
          >
            <!-- Moon Icon (for entering night mode) -->
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <!-- Sun Icon (for returning to day mode) -->
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>

          <!-- Spiritual Context Info / Settings Button (ग्रंथ परिचय एवं पठन शैली) -->
          <button
            id="reader-info-btn"
            class="icon-btn"
            aria-label={context ? 'ग्रंथ परिचय एवं सन्दर्भ' : 'पठन शैली सेटिंग'}
            title={context ? 'ग्रंथ परिचय एवं सन्दर्भ' : 'पठन शैली सेटिंग'}
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            {context ? (
              <svg class="icon-info" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="16" x2="12" y2="12" />
                <line x1="12" y1="8" x2="12.01" y2="8" />
              </svg>
            ) : (
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
              </svg>
            )}
          </button>

          <!-- Save Button (सहेजें) -->
          <button
            id="reader-save-btn"
            class="icon-btn"
            aria-label="ग्रंथ सहेजें"
            title="ग्रंथ सहेजें"
            aria-pressed="false"
          >
            <svg class="icon-bookmark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </button>

          <!-- Share Button (साझा करें) -->
          <button
            id="reader-share-btn"
            class="icon-btn"
            aria-label="ग्रंथ साझा करें"
            title="ग्रंथ साझा करें"
          >
            <svg class="icon-share" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
          </button>

          <!-- Chanting / Recitation Mode Button (पाठ मोड) with Prayer Beads Icon Only -->
          <button
            id="chanting-toggle"
            class="icon-btn topbar-btn--chanting"
            aria-label="पाठ मोड (केवल मूल श्लोक)"
            title="पाठ मोड — केवल मूल श्लोक (अर्थ छिपाएं)"
            aria-pressed="false"
          >
            <!-- Sacred Prayer Beads / Japa Mala Icon -->
            <svg class="icon-prayer-beads" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="9" r="6.5" stroke-dasharray="2.5 2.5" stroke-width="2.2" />
              <circle cx="12" cy="16.5" r="1.6" fill="currentColor" />
              <path d="M12 18.1v3.5M10.2 21.6h3.6" />
            </svg>
          </button>

          <!-- Fullscreen Toggle / Close Button -->
          <button
            id="fullscreen-toggle"
            class="icon-btn"
            aria-label="पूर्ण स्क्रीन"
            title="पूर्ण स्क्रीन"
            aria-pressed="false"
          >
            <!-- Enter Fullscreen Icon -->
            <svg class="icon-fullscreen-enter" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
            </svg>
            <!-- Exit / Close Fullscreen Icon -->
            <svg class="icon-fullscreen-exit" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="display:none;">
              <path d="M4 14h6v6m10-10h-6V4m0 6 7-7M9 15l-7 7"/>
            </svg>
          </button>
        </div>
      </header>

      <!-- Reading Viewport (3D Pothi Folio Stage) -->
      <main
        class="reader-viewport"
        id="reader-viewport"
        role="region"
        aria-label="सनातन धर्मग्रंथ पुस्तक पृष्ठ"
      >
        <!-- Sacred Aarambh Cover Screen (आरम्भ आवरण) -->
        <div class="reader-cover-screen" id="reader-cover-screen" role="region" aria-label="ग्रंथ आवरण">
          <div class="cover-card">
            <div class="cover-invocation">॥ श्रीहरिः ॥</div>
            
            <div class="cover-art-frame">
              <picture>
                <source srcset={resolvedWebpImage} type="image/webp" />
                <img 
                  src={resolvedJpgImage} 
                  alt={title} 
                  class="cover-art-img"
                  loading="eager"
                  decoding="async"
                  width="240"
                  height="340"
                  onerror="this.closest('picture')?.style.setProperty('display', 'none'); const fb = this.closest('.cover-art-frame')?.querySelector('.cover-art-fallback'); if (fb) fb.style.display = 'flex';"
                />
              </picture>
              <div class="cover-art-fallback" style={`background: linear-gradient(135deg, ${coverColor}, color-mix(in hsl, ${coverColor}, black 35%)); display:none;`}>
                <span class="cover-fallback-char">{title.charAt(0)}</span>
              </div>
            </div>

            <h1 class="cover-title">{title}</h1>
            {author && <p class="cover-author">{author}</p>}
            {category && (
              <a
                href={`${base}/category/${category.toLowerCase()}`}
                class="cover-category-badge"
                style="text-decoration:none;"
                title={`${getCategoryLabel(category)} संग्रह देखें`}
              >
                {getCategoryLabel(category)}
              </a>
            )}

            {tags.length > 0 && (
              <div class="cover-tags">
                {tags.map(tag => (
                  <a href={`${base}/tag/${tagToSlug(tag)}`} class="tag-chip">{tag}</a>
                ))}
              </div>
            )}

            {context && (
              <div class="cover-context-box">
                <p class="cover-context-text">{context}</p>
              </div>
            )}

            <!-- Phase 7: Reading Stats Badges (पठन सांख्यिकी) -->
            <div class="cover-stats-row" id="cover-stats-row">
              <span class="cover-stat-badge" id="cover-stat-time">⏱ गणना जारी...</span>
              <span class="cover-stat-badge" id="cover-stat-count">📄 पद गणना...</span>
            </div>

            <button 
              id="btn-aarambh" 
              class="btn-aarambh" 
              aria-label="पठन आरम्भ करें"
              type="button"
            >
              <span>📖</span>
              <span>आरम्भ करें</span>
            </button>

            <div class="cover-resume-indicator" id="cover-resume-indicator" style="display:none;">
              <span class="resume-progress-text" id="resume-progress-text"></span>
              <button type="button" class="resume-fresh-start" id="btn-fresh-start">प्रारम्भ से पढ़ें</button>
            </div>
          </div>
        </div>

        <!-- Tap zones for quick thumb-tap navigation -->
        <div class="tap-zone tap-zone--prev" id="tap-prev" title="पिछला पृष्ठ" aria-label="पिछला पृष्ठ"></div>
        <div class="tap-zone tap-zone--center" id="tap-center" title="पठन क्षेत्र" aria-label="पठन क्षेत्र"></div>
        <div class="tap-zone tap-zone--next" id="tap-next" title="अगला पृष्ठ" aria-label="अगला पृष्ठ"></div>

        <!-- Floating Navigation Buttons -->
        <div class="flip-floating-nav" id="flip-floating-nav" aria-label="पृष्ठ नियंत्रण">
          <button id="btn-page-up" class="flip-nav-btn" title="पिछला पृष्ठ (Up)" aria-label="पिछला पृष्ठ">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 15l-6-6-6 6"/></svg>
          </button>
          <button id="btn-page-down" class="flip-nav-btn" title="अगला पृष्ठ (Down)" aria-label="अगला पृष्ठ">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </div>

        <!-- Dynamic 3D Pothi Folio Stage -->
        <div class="reader-stage" id="reader-stage" aria-live="polite">
          <!-- Virtual book pages injected here -->
        </div>

        <!-- Raw source content (parsed at build time) -->
        <article class="reader-content reader-raw-source" id="reader-raw-source" data-slug={slug} itemscope itemtype="https://schema.org/CreativeWork">
          <header class="sr-only">
            <h1 itemprop="name">{title}</h1>
            {author && <p itemprop="author">{author}</p>}
            {context && <p itemprop="abstract">{context}</p>}
          </header>
          <slot />
        </article>
      </main>

      <!-- Sacred Completion Screen (पाठ समापन) -->
      <div class="reader-completion-screen" id="reader-completion-screen" role="region" aria-label="पाठ समापन" style="display:none;">
        <div class="completion-petals" id="completion-petals" aria-hidden="true"></div>
        <div class="completion-card">
          <button id="btn-completion-close" class="completion-close-btn" type="button" aria-label="समापन पृष्ठ बन्द करें" title="बन्द करें">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
          <div class="completion-invocation">॥ इति श्री {title} समाप्तम् ॥</div>
          <div class="completion-emoji">🙏</div>
          <h2 class="completion-title">पाठ संपूर्ण हुआ</h2>
          <p class="completion-subtitle">श्रद्धा एवं भक्ति से किया गया पाठ सदैव फलदायी होता है।</p>
          <div class="completion-actions">
            <button id="btn-completion-restart" class="completion-btn completion-btn--primary" type="button">
              <span>🔄</span> <span>पुनः पढ़ें</span>
            </button>
            <a href={category ? `${base}/category/${category.toLowerCase()}` : `${base}/`} class="completion-btn completion-btn--secondary" id="btn-completion-browse">
              <span>📚</span> <span>अन्य ग्रंथ पढ़ें</span>
            </a>
            <button id="btn-completion-share" class="completion-btn completion-btn--outline" type="button">
              <span>🔗</span> <span>साझा करें</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Table of Contents Sliding Drawer (विषय सूची दराज) -->
      <div id="reader-toc-drawer" class="reader-toc-drawer" role="dialog" aria-modal="true" aria-labelledby="toc-title" style="display:none;">
        <div class="reader-toc-backdrop" id="reader-toc-backdrop"></div>
        <aside class="reader-toc-panel" id="reader-toc-panel">
          <div class="reader-toc-header">
            <div class="reader-toc-title-group">
              <h2 id="toc-title" class="reader-toc-title">॥ विषय सूची ॥</h2>
              <span class="reader-toc-subtitle" id="reader-toc-subtitle">{title}</span>
            </div>
            <button id="reader-toc-close" class="reader-toc-close" aria-label="विषय सूची बन्द करें" title="बन्द करें">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <!-- Quick Search in TOC -->
          <div class="reader-toc-search-wrap">
            <div class="reader-toc-search-box">
              <span class="toc-search-icon" aria-hidden="true">🔍</span>
              <input
                type="text"
                id="reader-toc-search-input"
                class="reader-toc-search-input"
                placeholder="पद, संख्या या शब्द खोजें..."
                aria-label="विषय सूची में खोजें"
                autocomplete="off"
              />
              <button
                type="button"
                id="reader-toc-search-clear"
                class="reader-toc-search-clear"
                aria-label="खोज साफ़ करें"
                style="display:none;"
              >&times;</button>
            </div>
            <div class="reader-toc-stats" id="reader-toc-stats"></div>
          </div>

          <!-- TOC Items List -->
          <nav class="reader-toc-list" id="reader-toc-list" role="navigation" aria-label="ग्रंथ पद सूची">
            <!-- Dynamically populated by JavaScript -->
          </nav>

          <!-- Quick Navigation Footer -->
          <div class="reader-toc-footer">
            <button type="button" class="toc-quick-btn" id="toc-btn-goto-start">
              <span>⏮</span> <span>प्रारम्भ</span>
            </button>
            <button type="button" class="toc-quick-btn" id="toc-btn-goto-end">
              <span>⏭</span> <span>समापन</span>
            </button>
          </div>
        </aside>
      </div>

      <!-- Spiritual / Historical Context Popover Modal / Settings Modal -->
      <div id="reader-info-modal" class="reader-info-modal" role="dialog" aria-modal="true" aria-labelledby="modal-info-title" style="display:none;">
        <div class="reader-info-backdrop" id="reader-info-backdrop"></div>
        <div class="reader-info-dialog">
          <div class="reader-info-header">
            <h2 id="modal-info-title" class="reader-info-title">{context ? '॥ पावन परिचय एवं सन्दर्भ ॥' : '॥ पठन शैली सेटिंग ॥'}</h2>
            <button id="reader-info-close" class="icon-btn" aria-label="बन्द करें" title="बन्द करें">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="reader-info-body">
            <h3 class="reader-info-book-title">{title}</h3>
            {author && <p class="reader-info-author">रचयिता / ऋषि: <strong>{author}</strong></p>}
            {context && <p class="reader-info-context">{context}</p>}

            <!-- Reading Mode Setting (पठन शैली) -->
            <div class="reader-info-setting-row">
              <span class="setting-row-label">पठन शैली:</span>
              <div class="anim-toggle-group" id="reading-mode-toggle-group" role="radiogroup" aria-label="पठन शैली चुनें">
                <button type="button" class="anim-opt-btn" data-mode="scroll" title="सामान्य स्क्रोल — सभी उपकरणों पर सहज">स्क्रोल</button>
                <button type="button" class="anim-opt-btn" data-mode="3d" title="पूर्ण 3D पन्ना पलट">3D पन्ना</button>
                <button type="button" class="anim-opt-btn" data-mode="lite" title="द्रुत 2D पन्ना पलट">द्रुत Lite</button>
              </div>
            </div>

            <!-- Theme / Appearance Setting (थीम स्वरूप) -->
            <div class="reader-info-setting-row">
              <span class="setting-row-label">थीम स्वरूप:</span>
              <div class="anim-toggle-group" id="theme-toggle-group" role="radiogroup" aria-label="थीम चुनें">
                <button type="button" class="anim-opt-btn" data-theme="day" title="दिवस मोड — पावन ताम्रपत्र">☀️ दिवस</button>
                <button type="button" class="anim-opt-btn" data-theme="night" title="रात्रि मोड — नेत्र-सुखद गहरा काष्ठ">🌙 रात्रि</button>
              </div>
            </div>

            <!-- Auto-scroll Speed Setting (स्वचालित पठन गति) -->
            <div class="reader-info-setting-row">
              <span class="setting-row-label">स्वचालित गति:</span>
              <div class="anim-toggle-group" id="autoscroll-speed-toggle-group" role="radiogroup" aria-label="स्वचालित गति चुनें">
                <button type="button" class="anim-opt-btn active" data-speed="slow" title="धीमा (१x) — ध्यान एवं जप हेतु">धीमा (१x)</button>
                <button type="button" class="anim-opt-btn" data-speed="medium" title="मध्यम (१.५x) — सामान्य लयबद्ध पठन">मध्यम (१.५x)</button>
                <button type="button" class="anim-opt-btn" data-speed="fast" title="द्रुत (२x) — द्रुत पारायण">द्रुत (२x)</button>
              </div>
            </div>

            <!-- Verse Focus Setting (श्लोक ध्यान केंद्र) -->
            <div class="reader-info-setting-row">
              <span class="setting-row-label">श्लोक ध्यान:</span>
              <div class="anim-toggle-group" id="verse-focus-toggle-group" role="radiogroup" aria-label="श्लोक ध्यान केंद्र चुनें">
                <button type="button" class="anim-opt-btn active" data-focus="on" title="श्लोक ध्यान केंद्र — पढ़ते समय वर्तमान श्लोक प्रकाशित रहेगा">सक्रिय</button>
                <button type="button" class="anim-opt-btn" data-focus="off" title="सामान्य — बिना प्रकाश प्रभाव">सामान्य</button>
              </div>
            </div>

            <!-- Line-Height Setting (पंक्ति अन्तर) -->
            <div class="reader-info-setting-row">
              <span class="setting-row-label">पंक्ति अन्तर:</span>
              <div class="anim-toggle-group" id="line-height-toggle-group" role="radiogroup" aria-label="पंक्ति अन्तर चुनें">
                <button type="button" class="anim-opt-btn active" data-lh="normal" title="सामान्य (१.९x) — मानक अन्तर">सामान्य</button>
                <button type="button" class="anim-opt-btn" data-lh="relaxed" title="विस्तृत (२.३x) — खुला अन्तर">विस्तृत</button>
                <button type="button" class="anim-opt-btn" data-lh="loose" title="अति-विस्तृत (२.७x) — स्पष्ट पठन">अति-विस्तृत</button>
              </div>
            </div>

            <div class="reader-info-tradition-note">
              <span>पारम्परिक सनातन पाठ • सार्वजनिक कार्यक्षेत्र (Public Domain)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Bar (Navigation with Restart, Up/Down Arrows, and Font Controls) -->
      <footer class="reader-bottombar" role="navigation" aria-label="पठन नियंत्रण">
        <div class="bottombar-group bottombar-group--nav">
          <!-- Restart from Beginning Button -->
          <button
            id="btn-restart"
            class="icon-btn"
            aria-label="प्रारम्भ से पढ़ें"
            title="प्रारम्भ से पढ़ें"
            style="padding:0.4rem 0.65rem;"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M1 4v6h6"/>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
            </svg>
          </button>

          <!-- Auto-Scroll Play/Pause Button (स्वचालित पठन) -->
          <button
            id="btn-auto-scroll"
            class="icon-btn icon-btn--autoscroll"
            aria-label="स्वचालित पठन आरम्भ करें"
            title="स्वचालित पठन (हाथ-मुक्त पाठ) — आरम्भ करें"
            aria-pressed="false"
            style="padding:0.4rem 0.65rem;"
          >
            <!-- Play Icon -->
            <svg class="icon-play" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <!-- Pause Icon -->
            <svg class="icon-pause" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true" style="display:none;">
              <rect x="6" y="4" width="4" height="16"></rect>
              <rect x="14" y="4" width="4" height="16"></rect>
            </svg>
          </button>

          <!-- Floating Speed Switcher Badge -->
          <button
            type="button"
            id="autoscroll-floating-speed"
            class="autoscroll-speed-badge"
            style="display:none;"
            aria-label="स्वचालित गति बदलें"
            title="गति बदलें (क्लिक करें)"
          >१x</button>

          <!-- Previous Page Button (Arrow Up) -->
          <button
            id="btn-bottom-prev"
            class="icon-btn"
            aria-label="पिछला पृष्ठ"
            title="पिछला पृष्ठ"
            style="padding:0.4rem 0.65rem;"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 15l-6-6-6 6"/></svg>
          </button>
        </div>

        <!-- Interactive Progress Scrubber / Slider (प्रगति स्लाइडर) -->
        <div class="reader-scrubber-container" id="reader-scrubber-container">
          <!-- Floating Tooltip showing Section & Percentage -->
          <div class="reader-scrubber-tooltip" id="reader-scrubber-tooltip" style="display:none;" aria-hidden="true">
            <span class="scrubber-tooltip-badge" id="scrubber-tooltip-badge"></span>
            <span class="scrubber-tooltip-pct" id="scrubber-tooltip-pct"></span>
          </div>

          <!-- Draggable Track -->
          <div
            class="reader-scrubber-track"
            id="reader-scrubber-track"
            role="slider"
            aria-label="पठन प्रगति स्लाइडर"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            tabindex="0"
          >
            <div class="reader-scrubber-rail">
              <div class="reader-scrubber-fill" id="reader-scrubber-fill"></div>
              <div class="reader-scrubber-thumb" id="reader-scrubber-thumb"></div>
            </div>
          </div>

          <!-- Percentage Indicator -->
          <span class="reader-page-info" id="page-info" aria-live="polite">०%</span>
        </div>

        <div class="bottombar-group bottombar-group--controls">
          <!-- Next Page Button (Arrow Down) -->
          <button
            id="btn-bottom-next"
            class="icon-btn"
            aria-label="अगला पृष्ठ"
            title="अगला पृष्ठ"
            style="padding:0.4rem 0.65rem;"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          </button>

          <div class="bottombar-separator" aria-hidden="true"></div>

          <!-- Font Size Decrease Control -->
          <button
            id="font-decrease"
            class="icon-btn"
            aria-label="अक्षर छोटा करें"
            title="अक्षर छोटा करें"
            style="padding:0.4rem 0.65rem;"
          >अ<sup>-</sup></button>

          <!-- Font Size Increase Control -->
          <button
            id="font-increase"
            class="icon-btn"
            aria-label="अक्षर बड़ा करें"
            title="अक्षर बड़ा करें"
            style="padding:0.4rem 0.65rem;"
          >अ<sup>+</sup></button>
        </div>
      </footer>
    </div>

    <!-- ══════════════════════════════════════════════════════
         Client-Side 3D Pothi Page-Flip Engine
         ══════════════════════════════════════════════════════ -->

        <!-- Reader Engine Configuration & Client Bundle -->
    <script is:inline define:vars={{ slug, bookTitle: title, base }}>
      window.__GYANKOSH_READER__ = { slug, bookTitle, base };
    </script>
    <script src="../scripts/reader.js"></script>
  </body>
</html>
