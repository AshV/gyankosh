---
/**
 * src/components/SearchModal.astro
 * Site-wide Quick Search Modal for Gyankosh.
 *
 * Supports Dual-Script Search:
 * - English queries: "hanuman", "gita", "geeta", "shiv", "rudrashtakam"
 * - Hindi queries: "हनुमान", "गीता", "शिव", "चालीसा"
 *
 * All UI labels, hints, and placeholders are in authentic Hindi.
 */
import { getCollection } from 'astro:content';
import { sortTexts, getTextWeight } from '../utils/sorting';
import { deriveSearchKeywords, type SearchCatalogItem } from '../utils/search';

const allTexts = sortTexts(await getCollection('library'));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const CATEGORY_ICONS: Record<string, string> = {
  Veda: '🔥 वेद',
  Upanishad: '🕉️ उपनिषद्',
  Gita: '🎵 गीता',
  Chalisa: '🪔 चालीसा',
  Stotra: '🌸 स्तोत्र',
  Aarti: '🪔 आरती',
  Purana: '📖 पुराण',
  Other: '📜 अन्य',
};

// Pre-compute lightweight catalog payload for client-side search (~18KB)
const catalog: SearchCatalogItem[] = allTexts.map((text) => ({
  slug: text.id.replace(/\.md$/, ''),
  title: text.data.title,
  author: text.data.author || '',
  category: text.data.category,
  categoryHindi: CATEGORY_ICONS[text.data.category] || text.data.category,
  description: text.data.description || '',
  tags: text.data.tags || [],
  coverColor: text.data.coverColor,
  coverImage: text.data.coverImage,
  keywords: deriveSearchKeywords(text),
  weight: getTextWeight(text),
}));
---

<dialog id="gyankosh-search-dialog" class="gyankosh-search-dialog" aria-label="ग्रंथ खोज संवाद">
  <div class="search-modal-backdrop" data-close-modal></div>
  <div class="search-modal-container" role="document">
    <!-- Modal Header with Input -->
    <div class="search-modal-header">
      <div class="search-input-wrapper">
        <span class="search-icon" aria-hidden="true">🔍</span>
        <input
          type="search"
          id="global-search-input"
          class="search-modal-input"
          placeholder="ग्रंथ, देवता या विषय खोजें... (उदा. हनुमान, Gita, शिव)"
          autocomplete="off"
          spellcheck="false"
          aria-label="ग्रंथ खोजें"
        />
        <button
          type="button"
          id="search-clear-btn"
          class="search-clear-btn"
          aria-label="खोज साफ़ करें"
          style="display: none;"
        >
          ✕
        </button>
      </div>
      <button
        type="button"
        class="search-close-btn"
        data-close-modal
        aria-label="खोज खिड़की बंद करें"
      >
        <span aria-hidden="true">✕</span>
      </button>
    </div>

    <!-- Quick Stats Bar -->
    <div class="search-stats-bar">
      <span id="search-stats-text" class="search-stats-text">
        शीर्ष धर्मग्रंथ ({allTexts.length})
      </span>
      <span class="search-hint-script">हिन्दी एवं English दोनों में खोजें</span>
    </div>

    <!-- Results List -->
    <div
      id="search-results-list"
      class="search-results-list"
      role="listbox"
      aria-label="खोज परिणाम"
    >
      <!-- Populated via client-side script -->
    </div>

    <!-- Empty State -->
    <div id="search-empty-state" class="search-empty-state" style="display: none;">
      <div class="empty-icon" aria-hidden="true">🪷</div>
      <p class="empty-title">कोई ग्रंथ नहीं मिला</p>
      <p id="empty-desc" class="empty-desc">
        कृपया अन्य शब्द या अंग्रेजी नाम से खोजें।
      </p>
    </div>

    <!-- Modal Footer with Keyboard Navigation Hints -->
    <div class="search-modal-footer">
      <div class="search-shortcuts">
        <span class="shortcut-item"><kbd>↑</kbd><kbd>↓</kbd> नेविगेट</span>
        <span class="shortcut-item"><kbd>↵</kbd> पढ़ने हेतु</span>
        <span class="shortcut-item"><kbd>Esc</kbd> बंद करें</span>
      </div>
    </div>
  </div>
</dialog>

<!-- Client Catalog Data -->
<script is:inline id="gyankosh-catalog-data" type="application/json" set:html={JSON.stringify(catalog)} />

<script>
  import { normalizeSearchText, scoreSearchItem, type SearchCatalogItem } from '../utils/search';

  const base = (import.meta.env.BASE_URL || '/gyankosh').replace(/\/$/, '');

  function toHindiDigits(num: number): string {
    const digits = ['०', '१', '२', '३', '४', '५', '६', '७', '८', '९'];
    return num
      .toString()
      .split('')
      .map((d) => digits[parseInt(d, 10)] || d)
      .join('');
  }

  let catalog: SearchCatalogItem[] = [];
  try {
    const dataEl = document.getElementById('gyankosh-catalog-data');
    if (dataEl && dataEl.textContent) {
      catalog = JSON.parse(dataEl.textContent);
    }
  } catch (err) {
    console.error('Failed to load catalog data:', err);
  }

  const dialog = document.getElementById('gyankosh-search-dialog') as HTMLDialogElement | null;
  const searchInput = document.getElementById('global-search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('search-clear-btn');
  const resultsList = document.getElementById('search-results-list');
  const statsText = document.getElementById('search-stats-text');
  const emptyState = document.getElementById('search-empty-state');
  const emptyDesc = document.getElementById('empty-desc');

  let selectedIndex = -1;
  let currentResults: SearchCatalogItem[] = [];

  function openSearchModal(initialQuery = '') {
    if (!dialog) return;
    if (typeof dialog.showModal === 'function') {
      dialog.showModal();
    } else {
      dialog.setAttribute('open', 'true');
    }
    document.body.classList.add('modal-open');

    if (searchInput) {
      if (initialQuery) {
        searchInput.value = initialQuery;
      }
      setTimeout(() => {
        searchInput.focus();
        searchInput.select();
        performSearch(searchInput.value);
      }, 50);
    } else {
      performSearch('');
    }
  }

  function closeSearchModal() {
    if (!dialog) return;
    if (typeof dialog.close === 'function') {
      dialog.close();
    } else {
      dialog.removeAttribute('open');
    }
    document.body.classList.remove('modal-open');
    if (searchInput) {
      searchInput.value = '';
    }
  }

  function renderResults(items: SearchCatalogItem[], query: string) {
    if (!resultsList || !statsText || !emptyState) return;

    currentResults = items;
    selectedIndex = items.length > 0 ? 0 : -1;

    if (clearBtn) {
      clearBtn.style.display = query.trim() ? 'block' : 'none';
    }

    if (items.length === 0) {
      resultsList.innerHTML = '';
      resultsList.style.display = 'none';
      emptyState.style.display = 'block';
      if (emptyDesc) {
        emptyDesc.textContent = `‘${query}’ के लिए कोई ग्रंथ नहीं मिला। कृपया अन्य शब्द या अंग्रेजी नाम से खोजें।`;
      }
      statsText.textContent = 'कोई परिणाम नहीं (०)';
      return;
    }

    emptyState.style.display = 'none';
    resultsList.style.display = 'block';

    const countText = toHindiDigits(items.length);
    statsText.textContent = query.trim()
      ? `खोज परिणाम (${countText})`
      : `शीर्ष धर्मग्रंथ (${countText})`;

    resultsList.innerHTML = items
      .slice(0, 30) // Show up to 30 most relevant
      .map((item, index) => {
        const isSelected = index === selectedIndex;
        const authorHtml = item.author
          ? `<span class="result-author">॥ ${item.author} ॥</span>`
          : '';
        const tagsHtml = item.tags
          .slice(0, 3)
          .map((t) => `<span class="result-tag-chip">${t}</span>`)
          .join('');

        return `
          <a
            href="${base}/read/${item.slug}"
            class="search-result-item ${isSelected ? 'selected' : ''}"
            role="option"
            data-index="${index}"
            aria-selected="${isSelected}"
          >
            <div class="result-item-left">
              <span class="result-category-badge">${item.categoryHindi}</span>
              <div class="result-text-content">
                <span class="result-title">${item.title}</span>
                <div class="result-meta-row">
                  ${authorHtml}
                  <span class="result-slug">${item.slug}</span>
                </div>
              </div>
            </div>
            <div class="result-item-right">
              ${tagsHtml}
              <span class="result-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        `;
      })
      .join('');

    // Attach click listener to newly rendered items
    const resultElements = resultsList.querySelectorAll('.search-result-item');
    resultElements.forEach((el) => {
      el.addEventListener('mouseenter', (e) => {
        const target = e.currentTarget as HTMLElement;
        const idx = parseInt(target.dataset.index || '0', 10);
        updateSelection(idx);
      });
    });
  }

  function updateSelection(newIndex: number) {
    if (!resultsList || currentResults.length === 0) return;
    const items = resultsList.querySelectorAll('.search-result-item');
    if (!items.length) return;

    if (selectedIndex >= 0 && selectedIndex < items.length) {
      items[selectedIndex].classList.remove('selected');
      items[selectedIndex].setAttribute('aria-selected', 'false');
    }

    selectedIndex = Math.max(0, Math.min(newIndex, items.length - 1));
    const activeItem = items[selectedIndex] as HTMLElement;
    activeItem.classList.add('selected');
    activeItem.setAttribute('aria-selected', 'true');
    activeItem.scrollIntoView({ block: 'nearest' });
  }

  function performSearch(rawQuery: string) {
    const query = rawQuery.trim();
    if (!query) {
      renderResults(catalog, '');
      return;
    }

    const scored: { item: SearchCatalogItem; score: number }[] = [];
    for (const item of catalog) {
      const score = scoreSearchItem(item, query);
      if (score > 0) {
        scored.push({ item, score });
      }
    }

    scored.sort((a, b) => b.score - a.score);
    renderResults(scored.map((s) => s.item), query);
  }

  // Keyboard navigation & Shortcuts
  window.addEventListener('keydown', (e) => {
    // Open on Ctrl+K, Cmd+K, or slash (/) outside input
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (dialog?.open) {
        closeSearchModal();
      } else {
        openSearchModal();
      }
      return;
    }

    if (e.key === '/' && !dialog?.open) {
      const target = e.target as HTMLElement;
      if (
        target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.isContentEditable)
      ) {
        return;
      }
      e.preventDefault();
      openSearchModal();
      return;
    }

    // While Modal is Open
    if (dialog?.open) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeSearchModal();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateSelection(selectedIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateSelection(selectedIndex - 1);
      } else if (e.key === 'Enter') {
        if (selectedIndex >= 0 && currentResults[selectedIndex]) {
          e.preventDefault();
          const targetSlug = currentResults[selectedIndex].slug;
          window.location.href = `${base}/read/${targetSlug}`;
        }
      }
    }
  });

  // Input Events
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      performSearch(searchInput.value);
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        performSearch('');
      }
    });
  }

  // Close handlers
  document.querySelectorAll('[data-close-modal]').forEach((el) => {
    el.addEventListener('click', () => closeSearchModal());
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      closeSearchModal();
    }
  });

  // Global event listener to trigger search from any button
  window.addEventListener('gyankosh:open-search', ((e: CustomEvent) => {
    const q = e.detail?.query || '';
    openSearchModal(q);
  }) as EventListener);

  // Expose to window
  (window as any).openGyankoshSearch = openSearchModal;
  (window as any).closeGyankoshSearch = closeSearchModal;
</script>
