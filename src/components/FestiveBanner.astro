---
/**
 * src/components/FestiveBanner.astro
 * Auspicious Day & Hindu Festival Greeting Banner with Suggested Reads.
 *
 * Lightweight Dynamic Delivery:
 * Instead of embedding 37 heavy HTML cards (192+ KB) with hidden styles,
 * passes a compact JSON registry and dynamically builds ONLY today's active
 * card on the user's device. Shaves ~180 KB of HTML from index.html with
 * 100% identical styling, dismiss handling, and offline responsiveness.
 */
import { ANNUAL_FESTIVALS, WEEKLY_DEITIES } from '../data/festivals';

export interface Props {
  allTexts: any[];
}

const { allTexts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fast lookup map of books for suggested readings
const bookMap = new Map<string, { id: string; title: string; author?: string; coverColor?: string; coverImage?: string; category: string }>();
for (const t of allTexts) {
  bookMap.set(t.id, {
    id: t.id,
    title: t.data.title,
    author: t.data.author,
    coverColor: t.data.coverColor,
    coverImage: t.data.coverImage,
    category: t.data.category,
  });
}

// Category meta for badge icons
const categoryIcons: Record<string, string> = {
  Veda: '🔥',
  Upanishad: '🕉️',
  Gita: '🎵',
  Chalisa: '🪔',
  Stotra: '🌸',
  Aarti: '🪔',
  Purana: '📖',
  Other: '📜',
};

// Compact festival payload
const festivePayload = {
  annual: ANNUAL_FESTIVALS.map((fest) => ({
    id: fest.id,
    name: fest.name,
    icon: fest.icon,
    subtitle: fest.subtitle,
    greeting: fest.greeting,
    startDate: fest.startDate,
    endDate: fest.endDate,
    books: fest.suggestedSlugs
      .map((slug) => bookMap.get(slug))
      .filter((b): b is NonNullable<typeof b> => Boolean(b))
      .slice(0, 4),
  })),
  weekly: Object.values(WEEKLY_DEITIES).map((day) => ({
    dayOfWeek: day.dayOfWeek,
    name: day.name,
    icon: day.icon,
    deity: day.deity,
    greeting: day.greeting,
    books: day.suggestedSlugs
      .map((slug) => bookMap.get(slug))
      .filter((b): b is NonNullable<typeof b> => Boolean(b))
      .slice(0, 4),
  })),
};
---

<aside id="festive-banner" class="festive-banner" aria-label="पर्व एवं पावन दिवस शुभकामना" style="display: none;">
  <div class="festive-container" id="festive-container"></div>
</aside>

<script is:inline define:vars={{ festivePayload, base, categoryIcons }}>
  (() => {
    const banner = document.getElementById('festive-banner');
    const container = document.getElementById('festive-container');
    if (!banner || !container) return;

    // Get client local date in YYYY-MM-DD
    const now = new Date();
    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const day = String(now.getDate()).padStart(2, '0');
    const todayStr = `${year}-${month}-${day}`;
    const dayOfWeek = now.getDay(); // 0 = Sunday, 1 = Monday, ...

    // Check if dismissed for today's session
    const dismissKey = `gyankosh_festive_dismissed_${todayStr}`;
    if (sessionStorage.getItem(dismissKey) === 'true') {
      return;
    }

    // 1. Check for matching Annual Festival
    let matchedAnnual = null;
    for (const fest of festivePayload.annual) {
      if (fest.startDate && fest.endDate && todayStr >= fest.startDate && todayStr <= fest.endDate) {
        matchedAnnual = fest;
        break;
      }
    }

    // 2. Fallback: Match Weekly Sacred Deity
    const match = matchedAnnual || festivePayload.weekly.find((w) => w.dayOfWeek === dayOfWeek);
    if (!match) return;

    const isAnnual = Boolean(matchedAnnual);
    const subtitleHtml = match.subtitle
      ? `<span class="festive-subtitle-pill">${match.subtitle}</span>`
      : (match.deity ? `<span class="festive-subtitle-pill">${match.deity}</span>` : '');

    let suggestedHtml = '';
    if (match.books && match.books.length > 0) {
      const labelIcon = isAnnual ? '📖' : '🪔';
      const labelText = isAnnual ? 'इस पावन अवसर पर अनुशंसित पाठ:' : 'आज का पावन स्वाध्याय एवं आराधना:';
      
      const chips = match.books.map((book) => {
        const readUrl = `${base}/read/${book.id}`;
        const rawCover = book.coverImage
          ? (book.coverImage.startsWith('http') ? book.coverImage : `${base}${book.coverImage.startsWith('/') ? '' : '/'}${book.coverImage}`)
          : `${base}/covers/${book.id}.webp`;
        const webpCover = rawCover.endsWith('.jpg') ? rawCover.replace(/\.jpg$/, '.webp') : rawCover;
        const jpgCover = rawCover.endsWith('.webp') ? rawCover.replace(/\.webp$/, '.jpg') : rawCover;
        const catIcon = categoryIcons[book.category] || '📜';
        const authorHtml = book.author ? `<span class="festive-chip-author">${book.author}</span>` : '';

        return `
          <a href="${readUrl}" class="festive-book-chip" role="listitem">
            <div class="festive-chip-thumb">
              <picture>
                <source srcset="${webpCover}" type="image/webp" />
                <img
                  src="${jpgCover}"
                  alt="${book.title}"
                  class="festive-chip-img"
                  loading="lazy"
                  width="48"
                  height="68"
                  onerror="this.style.display='none'; const fb = this.parentElement?.nextElementSibling; if (fb) fb.style.display='flex';"
                />
              </picture>
              <div class="festive-chip-fallback" style="background: ${book.coverColor || 'hsl(22, 70%, 45%)'}; display: none;">
                <span>${catIcon}</span>
              </div>
            </div>
            <div class="festive-chip-meta">
              <span class="festive-chip-title">${book.title}</span>
              ${authorHtml}
              <span class="festive-chip-cta">पाठ करें →</span>
            </div>
          </a>
        `;
      }).join('');

      suggestedHtml = `
        <div class="festive-suggested-wrap">
          <div class="festive-suggested-label">
            <span aria-hidden="true">${labelIcon}</span>
            <span>${labelText}</span>
          </div>
          <div class="festive-books-grid" role="list">
            ${chips}
          </div>
        </div>
      `;
    }

    container.innerHTML = `
      <div class="festive-card" data-type="${isAnnual ? 'annual' : 'weekly'}" data-festival-id="${match.id || ''}">
        <div class="festive-card-header">
          <div class="festive-badge-group">
            <span class="festive-icon" aria-hidden="true">${match.icon}</span>
            <span class="festive-occasion-label">${match.name}</span>
            ${subtitleHtml}
          </div>
          <button
            type="button"
            class="festive-dismiss-btn"
            aria-label="शुभकामना संदेश बन्द करें"
            title="बन्द करें"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="festive-body">
          <p class="festive-greeting-text">${match.greeting}</p>
        </div>
        ${suggestedHtml}
      </div>
    `;

    banner.style.display = 'block';

    const dismissBtn = container.querySelector('.festive-dismiss-btn');
    if (dismissBtn) {
      dismissBtn.addEventListener('click', (e) => {
        e.preventDefault();
        banner.classList.add('is-dismissing');
        setTimeout(() => {
          banner.style.display = 'none';
          sessionStorage.setItem(dismissKey, 'true');
        }, 300);
      });
    }
  })();
</script>

<style>
  .festive-banner {
    margin: 0 0 2rem 0;
    transition: opacity 0.3s ease, transform 0.3s ease, max-height 0.3s ease;
  }

  .festive-banner.is-dismissing {
    opacity: 0;
    transform: translateY(-8px);
  }

  .festive-container {
    width: 100%;
  }

  .festive-banner :global(.festive-card) {
    background: linear-gradient(135deg, rgba(255, 248, 235, 0.95), rgba(254, 243, 220, 0.85));
    border: 1px solid var(--color-border, #e5d8c3);
    border-left: 4px solid var(--color-accent, #8e1b14);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 4px 16px rgba(100, 30, 22, 0.06);
    position: relative;
    overflow: hidden;
  }

  :global(.reader-night-mode) .festive-banner :global(.festive-card) {
    background: linear-gradient(135deg, rgba(38, 28, 20, 0.95), rgba(48, 33, 24, 0.85));
    border-color: rgba(180, 83, 9, 0.3);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .festive-banner :global(.festive-card-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .festive-banner :global(.festive-badge-group) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .festive-banner :global(.festive-icon) {
    font-size: 1.35rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .festive-banner :global(.festive-occasion-label) {
    font-family: var(--font-devanagari);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-accent, #8e1b14);
    letter-spacing: 0.01em;
  }

  .festive-banner :global(.festive-subtitle-pill) {
    font-family: var(--font-devanagari);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: rgba(142, 27, 20, 0.08);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(142, 27, 20, 0.15);
  }

  .festive-banner :global(.festive-dismiss-btn) {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.35rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .festive-banner :global(.festive-dismiss-btn:hover) {
    background: rgba(142, 27, 20, 0.1);
    color: var(--color-accent);
  }

  .festive-banner :global(.festive-body) {
    margin-bottom: 1rem;
  }

  .festive-banner :global(.festive-greeting-text) {
    font-family: var(--font-devanagari);
    font-size: 1.02rem;
    color: var(--color-ink);
    line-height: 1.6;
    margin: 0;
  }

  .festive-banner :global(.festive-suggested-wrap) {
    border-top: 1px dashed var(--color-border-subtle, rgba(229, 216, 195, 0.8));
    padding-top: 0.85rem;
    margin-top: 0.5rem;
  }

  .festive-banner :global(.festive-suggested-label) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-devanagari);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.65rem;
  }

  .festive-banner :global(.festive-books-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .festive-banner :global(.festive-book-chip) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.65rem;
    background: var(--color-bg-card, #fff9f0);
    border: 1px solid var(--color-border-subtle, #e5d8c3);
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .festive-banner :global(.festive-book-chip:hover) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(142, 27, 20, 0.12);
    border-color: var(--color-accent);
  }

  .festive-banner :global(.festive-chip-thumb) {
    width: 42px;
    height: 60px;
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-bg);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .festive-banner :global(.festive-chip-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .festive-banner :global(.festive-chip-fallback) {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: #fff;
  }

  .festive-banner :global(.festive-chip-meta) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .festive-banner :global(.festive-chip-title) {
    font-family: var(--font-devanagari);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .festive-banner :global(.festive-chip-author) {
    font-family: var(--font-devanagari);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .festive-banner :global(.festive-chip-cta) {
    font-family: var(--font-devanagari);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-top: 0.15rem;
  }

  @media (max-width: 640px) {
    .festive-banner :global(.festive-card) {
      padding: 1rem;
    }

    .festive-banner :global(.festive-occasion-label) {
      font-size: 1.08rem;
    }

    .festive-banner :global(.festive-greeting-text) {
      font-size: 0.95rem;
    }

    .festive-banner :global(.festive-books-grid) {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .festive-banner :global(.festive-book-chip) {
      padding: 0.45rem 0.55rem;
    }
  }
</style>
