---
/**
 * BookCard.astro
 * Premium book card for the catalog/category pages.
 * Shows generated cover art, title, author, category chip, and resume-reading progress.
 */
export interface Props {
  slug: string;
  title: string;
  author?: string;
  description: string;
  category: string;
  language: string;
  coverColor?: string;
  coverImage?: string;
}

const {
  slug,
  title,
  author,
  description,
  category,
  language,
  coverColor = 'hsl(22, 70%, 45%)',
  coverImage,
} = Astro.props;

// Category → emoji & Hindi name mapping
const categoryMeta: Record<string, { icon: string; nameHindi: string }> = {
  Veda:      { icon: '🔥', nameHindi: 'वेद' },
  Upanishad: { icon: '🕉️', nameHindi: 'उपनिषद्' },
  Gita:      { icon: '🎵', nameHindi: 'गीता' },
  Chalisa:   { icon: '🪔', nameHindi: 'चालीसा' },
  Stotra:    { icon: '🌸', nameHindi: 'स्तोत्र' },
  Aarti:     { icon: '🪔', nameHindi: 'आरती' },
  Purana:    { icon: '📖', nameHindi: 'पुराण' },
  Other:     { icon: '📜', nameHindi: 'अन्य' },
};

const languageNames: Record<string, string> = {
  Sanskrit: 'संस्कृत',
  Hindi: 'हिन्दी',
  Awadhi: 'अवधी',
  'Vedic Sanskrit': 'वैदिक संस्कृत',
  'Hindi/Awadhi': 'हिन्दी/अवधी',
};
const resolvedLanguage = languageNames[language] ?? language;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const meta = categoryMeta[category] ?? { icon: '📜', nameHindi: category };
const readUrl = `${base}/read/${slug}`;
const categoryUrl = `${base}/category/${category.toLowerCase()}`;
const resolvedCoverImage = coverImage
  ? (coverImage.startsWith('http') ? coverImage : `${base}${coverImage.startsWith('/') ? '' : '/'}${coverImage}`)
  : `${base}/covers/${slug}.jpg`;
---

<a
  href={readUrl}
  class="book-card"
  data-slug={slug}
  data-category={category}
  aria-label={`पठन: ${title}`}
>
  <!-- Generated / Album Cover Art -->
  <div class="book-card-cover">
    <img 
      src={resolvedCoverImage} 
      alt={`${title}${author ? ` — ${author}` : ''} पुस्तक आवरण`} 
      class="book-card-cover-img"
      loading="lazy"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
    <div 
      class="book-card-cover-pattern" 
      style={`background: linear-gradient(135deg, ${coverColor}, color-mix(in hsl, ${coverColor}, black 35%));`}
      aria-hidden="true"
    >
      <span class="book-card-cover-title" aria-hidden="true">{title.charAt(0)}</span>
    </div>
  </div>

  <!-- Card Body -->
  <div class="book-card-body">
    <p class="book-card-title">{title}</p>

    <div class="book-card-footer">
      <div class="book-card-badges">
        <span
          class="chip"
          aria-label={`${meta.nameHindi} श्रेणी`}
        >
          {meta.icon} {meta.nameHindi}
        </span>
        <span class="language-badge">{resolvedLanguage}</span>
      </div>
      
      <!-- Progress badge — populated client-side from localStorage -->
      <span
        class="book-card-progress"
        data-progress-badge={slug}
        style="display:none"
        aria-label="पठन प्रगति"
      >
        <span class="progress-dot" aria-hidden="true"></span>
        <span class="progress-label"></span>
      </span>

      <span class="book-card-cta" aria-hidden="true">पढ़ें →</span>
    </div>
  </div>
</a>

<script>
  function toHindiDigits(num: number): string {
    const digits = ['०', '१', '२', '३', '४', '५', '६', '७', '८', '९'];
    return num.toString().split('').map(d => digits[parseInt(d, 10)] || d).join('');
  }

  // Populate reading progress badges from localStorage (runs client-side)
  document.addEventListener('DOMContentLoaded', () => {
    const badges = document.querySelectorAll<HTMLElement>('[data-progress-badge]');
    badges.forEach(badge => {
      const slug = badge.dataset.progressBadge!;
      const key = `gyankosh_progress_${slug}`;
      const saved = localStorage.getItem(key);
      if (saved) {
        try {
          const data = JSON.parse(saved);
          if (data.isCompleted || data.percent >= 99.5) {
            badge.style.display = 'none';
          } else if (data.percent && data.percent > 2) {
            badge.style.display = 'flex';
            const label = badge.querySelector('.progress-label');
            if (label) label.textContent = `${toHindiDigits(Math.round(data.percent))}% पठित`;
          }
        } catch {}
      }
    });
  });
</script>
