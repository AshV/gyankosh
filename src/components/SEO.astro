---
/**
 * SEO.astro
 * Dynamic SEO head tags — title, meta description, canonical, OG, Twitter, JSON-LD.
 * All values are driven by YAML frontmatter at build-time.
 */
export interface Props {
  title: string;
  description: string;
  canonical: string;
  author?: string;
  language?: string;
  type?: 'website' | 'book' | 'article';
  image?: string;
  keywords?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  author,
  language = 'Sanskrit',
  type = 'website',
  image,
  keywords = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const siteName = 'ज्ञानकोश — सनातन धर्मग्रंथ';
const fullTitle = `${title} | ${siteName}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const defaultOgImage = `https://www.ashishvishwakarma.com${base}/og-default.jpg`;

let resolvedImage = image || defaultOgImage;
if (resolvedImage && !resolvedImage.startsWith('http://') && !resolvedImage.startsWith('https://')) {
  resolvedImage = `https://www.ashishvishwakarma.com${resolvedImage.startsWith('/') ? '' : '/'}${resolvedImage}`;
}

const ogType = type === 'book' ? 'book' : (type === 'article' ? 'article' : 'website');

// Normalize jsonLd to an array for rendering
const jsonLdArray = jsonLd
  ? Array.isArray(jsonLd) ? jsonLd : [jsonLd]
  : [];
const isSanskrit = language && language.toLowerCase().includes('sanskrit');
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author ?? siteName} />
<meta name="language" content={language} />
<link rel="canonical" href={canonical} />

<!-- Robots -->
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}

<!-- Language Alternates -->
<link rel="alternate" hreflang="hi" href={canonical} />
{isSanskrit && <link rel="alternate" hreflang="sa" href={canonical} />}
<link rel="alternate" hreflang="x-default" href={canonical} />

<!-- Keywords (from content tags) -->
{keywords.length > 0 && (
  <meta name="keywords" content={keywords.join(', ')} />
)}

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:secure_url" content={resolvedImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content="hi_IN" />
{author && <meta property="book:author" content={author} />}

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage} />
<meta name="twitter:image:alt" content={title} />

<!-- JSON-LD Structured Data (Schema.org) -->
{jsonLdArray.map((ld) => (
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
))}
